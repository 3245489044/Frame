# public

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Python virtual environment
.venv/

# Log files
logs/

# Database files
*.db
*.sqlite

# SQLite WAL / shared-memory / rollback journal companion files
*.db-shm
*.db-wal
*.db-journal

# Executable files
*.exe
*.dll
*.pdb

# IDE cache files
*.lscache

# Plugin directory (local development notes)
Plugin/

# Godot build outputs (all subprojects)
Godot/**/bin/
Godot/**/obj/
Godot/**/*.lscache

# Token Savior cache (large JSON cache files)
.token-savior-cache.json

# Build logs and temporary output files
*.log
diff_output.txt
build_output.txt

# NuGet tool cache (dotnet tool install location)
.tools/

# VSCode Counter output
.VSCodeCounter/

# PScriptManager registry (auto-generated, rebuild with Build-Registry.ps1)
PowerShellScript/PScriptManager/psm-registry.json

# Turbo build cache (TypeScript monorepo)
TypeScriptPrj/.turbo/
TypeScriptPrj/turbo.json

# Centralized credentials (API keys) - NEVER commit!
credentials/


# Agent 数据库介质（数据介质，独立于 AI 运行时，纳入版本控制）
!Agent/data/agent.db
!Agent/data/graph.db

# PScriptManager Framework compiled function index (auto-generated, rebuild with Build-FunctionIndex.ps1)
PowerShellScript/PScriptManager/Framework/ps-function-index.json

# Remove-RedundantLogMessages rollback snapshots (throwaway, per-run timestamp dir)
PowerShellScript/Operation/backups/
