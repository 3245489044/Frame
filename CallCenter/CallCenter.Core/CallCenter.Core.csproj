<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CallCenter.Core</RootNamespace>
    <AssemblyName>CallCenter.Core</AssemblyName>
  </PropertyGroup>

  <!-- ★ 烘焙轨（方案 B，2026-09-12）：CsharpPrj 上游走权威烘焙二进制引用（$(CsharpBuildOutputDir)），
       Private=false 不复制产物 —— 本区输出不再持有上游 dll；运行期由 CallCenter.Host 的
       [ModuleInitializer] 探针（Bootstrap\FrameBootstrap.cs）从权威目录就地解析。 -->
  <ItemGroup Label="CsharpPrjBakedRefs">
    <!-- 数据面：CSG 统一中间表示（工具契约/调用子图/schema/fingerprint 的 CanonicalForm） -->
    <Reference Include="CSG.Unified" HintPath="$(CsharpBuildOutputDir)CSG.Unified.dll" Private="false" />
    <!-- 仅引用 TConfig 契约（ITrConfigRegistry/IParamConfig/FunctionDescriptor），供 C#Track 发现源以
         轻量收集器执行函数库 RegisterAll(ITrConfigRegistry)，不把 Modules.Registry/Roslyn 栈拉进 Core。 -->
    <Reference Include="Modules.TConfig" HintPath="$(CsharpBuildOutputDir)Modules.TConfig.dll" Private="false" />
  </ItemGroup>

</Project>
