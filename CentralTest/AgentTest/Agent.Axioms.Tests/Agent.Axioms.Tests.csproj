<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 编译输出统一到 CentralTest\BuildOutput -->
    <OutputPath>..\..\BuildOutput\$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>..\..\BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 导入版本号定义（从 CsharpPrj 共享的版本文件） -->
  <Import Project="..\..\..\CsharpPrj\generated\Directory.Build.props.versions.generated.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MSTestTestAdapterVersion)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MSTestTestFrameworkVersion)" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentTest.csproj" />
    <!-- 节点执行引擎已迁入 Agent.Core/Nodes（收敛 Phase 0），StepExecution 命名空间类型测试需引用 Core -->
    <!-- 技能协作通用逻辑（信封契约/分发端口/技能选择装配）下沉至 Agent.Skill -->
  </ItemGroup>

</Project>

