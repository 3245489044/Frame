<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 编译输出统一到 CentralTest\BuildOutput -->
    <OutputPath>..\..\BuildOutput\$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>..\..\BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 导入版本号定义（从 CsharpPrj 共享的版本文件） -->
  <Import Project="..\..\..\CsharpPrj\generated\Directory.Build.props.versions.generated.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MSTestTestAdapterVersion)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MSTestTestFrameworkVersion)" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentTest.csproj" />
    <ProjectReference Include="..\..\TestInfrastructure\TestInfrastructure.csproj" />
    <!-- 组合根：验证 agent-config.json 路径解析（provider fail-fast 守卫前置） -->
    <!-- 会话编排壳（形态 A）：ConversationPipeline/ConversationSessionService 迁入 -->
    <!-- 通用任务池（Share/TaskStatusPool）契约 + InMemoryTaskPoolPersistence：RuleTaskExecutor 路由测试 -->
    <!-- 通用循环驱动契约（LoopFoldMethod，Agent 无关、LLM-free）：LoopDriver/LoopTermination 单测 -->
    <!-- 技能协作通用逻辑（信封契约/分发端口/技能选择装配）下沉至 Agent.Skill -->
    <!-- 混合调度契约（Share.AiScheduling）：HistoryDecisionMapper/HistoryLoopDecider 单测直接使用 SchedulerDecision/SchedulerAction 等 -->
  </ItemGroup>

  <!-- 会话渲染测试从 AgentRuntimeUI.json（唯一模板源）装配模板：把该配置拷贝进测试输出，单测按 Configs\AgentRuntimeUI.json 加载 -->
  <ItemGroup>
    <Content Include="..\..\..\FileDriven\DrivenConfig\JsonConfig\AgentRuntimeUI.json"
             Link="Configs\AgentRuntimeUI.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 既有缺失特性：DynamicWorkflowMerger 已实现；EndToEndIntegrationTests 依赖 UnifiedRegistryCenter 框架初始化（无法在裸 MSTest 宿主运行），故仍排除。 -->
  <ItemGroup>
    <Compile Remove="EndToEndIntegrationTests.cs" />
    <!-- 会话端到端复现（真实 cline_execute/answer 函数 + 真实 WorkflowRunner）同样依赖 UnifiedRegistryCenter，
         仅在 GUI 装配环境（有 FrameworkInitializer）可运行，裸 MSTest 宿主排除，文件保留供 GUI 环境复现验证。 -->
    <Compile Remove="EndToEndConversationLocalTests.cs" />
    <!-- 统一装配框架（PromptAssembler 引擎 / UiView·LlmView 双投影 / UI≡LLM 校验） -->
  </ItemGroup>

</Project>

