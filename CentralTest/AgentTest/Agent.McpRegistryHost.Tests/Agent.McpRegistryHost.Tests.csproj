<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>Agent McpRegistryHost 宿主工具测试</ModuleRule_Title>
    <ModuleRule_Layer>0</ModuleRule_Layer>
    <ModuleRule_Description>Agent.McpRegistryHost 宿主侧工具（llm_chat 统一 LLM 出口等）的单元测试。</ModuleRule_Description>
    <ModuleRule_Keywords>Agent;McpRegistryHost;llm_chat;LLM;测试;单元测试</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- 编译输出统一到 CentralTest\BuildOutput -->
    <OutputPath>..\..\BuildOutput\$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>..\..\BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 导入版本号定义（从 CsharpPrj 共享的版本文件） -->
  <Import Project="..\..\..\CsharpPrj\generated\Directory.Build.props.versions.generated.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MSTestTestAdapterVersion)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MSTestTestFrameworkVersion)" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- CallCenterFoldToolProvider 单测需引用 CallCenter.Core（其构造签名用 ToolRouter/ToolRouterReference）。
         CallCenter.Core.dll 已被 Agent.McpRegistryHost 依赖并落在 Agent 权威输出目录，此处同源引用（与 AgentTest props 同范式）。 -->
    <Reference Include="CallCenter.Core">
      <HintPath>$(AgentProjectRoot)\BuildOutput\$(Configuration)\CallCenter.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
