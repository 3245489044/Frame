<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>Agent 测试控制台</ModuleRule_Title>
    <ModuleRule_Layer>0</ModuleRule_Layer>
    <ModuleRule_Description>Agent 测试框架，包含 Agent 核心模块的单元测试和集成测试</ModuleRule_Description>
    <ModuleRule_Keywords>Agent;测试;控制台;启动入口;单元测试</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是 Agent 测试的启动入口，依赖 Agent.Core 和 Agent 相关模块" />
    <ModuleRule_Rule Include="此模块包含所有 Agent 测试项目" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要运行 Agent 测试、执行 Agent 单元测试时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块的 Program.cs 是 Agent 测试入口点" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentTest</AssemblyName>
    <RootNamespace>AgentTest</RootNamespace>
    <StartupObject>AgentTest.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 编译输出统一到 CentralTest\BuildOutput -->
    <OutputPath>..\BuildOutput\$(Configuration)\$(TargetFramework)\</OutputPath>
    <IntermediateOutputPath>..\BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <!-- 导入版本号定义（从 CsharpPrj 共享的版本文件） -->
  <Import Project="..\..\CsharpPrj\generated\Directory.Build.props.versions.generated.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsLoggingVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsLoggingConsoleVersion)" />
  </ItemGroup>

  <!-- 统一排除所有测试/临时目录 -->
  <ItemGroup>
    <Compile Remove="**\*Tests\**" />
    <Content Remove="**\*Tests\**" />
    <EmbeddedResource Remove="**\*Tests\**" />
    <None Remove="**\*Tests\**" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
