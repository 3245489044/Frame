<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>中央控制台</ModuleRule_Title>
    <ModuleRule_Layer>0</ModuleRule_Layer>
    <ModuleRule_Description>测试框架，包含程序运行器、测试基础设施、集成测试等</ModuleRule_Description>
    <ModuleRule_Keywords>测试框架,控制台,启动入口,测试,集成</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是启动入口，依赖 BasicMethod 和 Operation.WdUI" />
    <ModuleRule_Rule Include="此模块包含所有测试项目" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要运行程序、执行测试、查看集成测试结果时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块的 Program.cs 是应用程序入口点" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CentralConsole</AssemblyName>
    <RootNamespace>CentralConsole</RootNamespace>
    <StartupObject>CentralConsole.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="CliWrap" Version="3.10.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="programs.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 统一排除所有测试/临时目录 -->
  <ItemGroup>
    <Compile Remove="**\*Tests\**" />
    <Content Remove="**\*Tests\**" />
    <EmbeddedResource Remove="**\*Tests\**" />
    <None Remove="**\*Tests\**" />
    <Compile Remove="WorkFlowTest\**" />
    <Content Remove="WorkFlowTest\**" />
    <EmbeddedResource Remove="WorkFlowTest\**" />
    <None Remove="WorkFlowTest\**" />
    <Compile Remove="Share.Tsets\**" />
    <Content Remove="Share.Tsets\**" />
    <EmbeddedResource Remove="Share.Tsets\**" />
    <None Remove="Share.Tsets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- ★ 原引用 ..\..\CsharpPrj\Operation\WdUI\WdUI.csproj 为失效死引用（该路径不存在，MSB9008 警告）；
         WdUI 相关能力已由 CsharpPrjAggregationRefs（CentralTest\Directory.Build.props 注入的聚合闭包）覆盖，删除后无影响 -->
    <ProjectReference Include="..\TestInfrastructure\TestInfrastructure.csproj" />
  </ItemGroup>


</Project>

