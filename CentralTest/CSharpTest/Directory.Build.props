<Project>
  <!-- 加载仓库根属性（AgentProjectRoot 等单一真源；向上回溯，移动自适应） -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- 与 CsharpPrj/Directory.Build.props 保持一致，避免 AssemblyInfo 重复生成 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <!-- ★ CentralTest 目录下所有项目禁用所有警告（测试项目不需要关注警告） -->
    <!-- CS0436=类型冲突, CS0618=已过时, CS8600/8601/8604/8625=null 相关 -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CS0436;CS0618;CS8600;CS8601;CS8604;CS8625;AD0001;SYSLIB</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis>false</RunAnalyzersDuringLiveAnalysis>
    <RunAnalyzers>false</RunAnalyzers>

    <!-- ★ 固定 Configuration 默认值：Directory.Build.props 求值早于项目主体，
         $(Configuration) 仅在作为全局属性传入（dotnet build -c / VS）时才非空，
         否则 OutputPath 落空导致产物分叉到不同目录。先设默认保证所有构建方式收敛。 -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- ★ 统一编译输出到 BuildOutput\$(Configuration)\
         注意：不追加 $(TargetFramework)——该属性定义于 csproj 主体，props 求值期恒为空，
         且追加会使不同 TFM 分散目录，违背统一输出意图（实测布局即为 BuildOutput\Debug\ 根目录） -->
    <OutputPath>$(MSBuildThisFileDirectory)BuildOutput\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
