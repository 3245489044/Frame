    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyTitle>FunctionStorage.Tests</AssemblyTitle>
    <AssemblyDescription>函数存储框架测试程序</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
