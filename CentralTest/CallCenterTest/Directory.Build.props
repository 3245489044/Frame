<Project>
  <!-- 加载仓库根属性（CsharpProjectRoot/RepoRoot 等单一真源；向上回溯，移动自适应）。
       刻意不加载 CentralTest\Directory.Build.props —— 该层注入 CsharpPrj 6 大聚合 ProjectReference；
       CallCenter 测试只需被测对象 CallCenter.Core（仅依赖 CSG.Unified/TConfig），
       故像 CSharpTest 一样只向上取仓库根，避免拖入 BasicMethod/Strategy 等无关聚合与编译期膨胀。 -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <!-- 测试项目不关注警告 -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CS0436;CS0618;CS8600;CS8601;CS8604;CS8625;AD0001;SYSLIB</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- 统一 Configuration 默认值，防 OutputPath 分叉 -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>

    <!-- 统一编译输出到 CentralTest\BuildOutput\$(Configuration)\（无 TFM 层，与 CentralTest 其余测试工程一致） -->
    <OutputPath>$(MSBuildThisFileDirectory)..\BuildOutput\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>$(MSBuildThisFileDirectory)..\BuildOutput\obj\$(MSBuildProjectName)\</IntermediateOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
</Project>
