<Project>
  <!-- 加载仓库根属性（CsharpProjectRoot 等单一真源；向上回溯，移动自适应） -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <!-- ★ CsharpPrj 收敛：不再注入 6 大聚合 ProjectReference（那会把 CsharpPrj 源码整链拉进
       CentralTest 编译、测试对象并非权威 dll）。改为【二进制消费权威烘焙目录】——同 Agent 消费 CsharpPrj
       的范式（Directory.Build.props 集中 <Reference HintPath> + RequireCsharpPrjBaked 守护），
       测试改完只重编测试，产品 dll 取自 CsharpPrj\BuildOutput\$(Configuration) 单一真源。
       闭包引用清单见 build/props/CsharpPrj.BinaryRefs.props（权威目录扫描全集，含排除框架/第三方）。
       NuGet：二进制 <Reference> 不传递 PackageReference；个别测试直接用到第三方类型时在自身 csproj 补包。 -->

  <!-- 烘焙守护开关：权威目录缺 dll 时由仓库根 Directory.Build.targets 的 EnsureCsharpBaked 先烘焙 MainProj.sln -->
  <PropertyGroup>
    <RequireCsharpPrjBaked>true</RequireCsharpPrjBaked>
  </PropertyGroup>

  <!-- 共享版本号定义（MSTest/Test.Sdk 等 $(...) 版本变量来源；TestInfrastructure/AgentTest.csproj 曾各自 import，此处统一点入消除 NU1015） -->
  <Import Project="..\CsharpPrj\generated\Directory.Build.props.versions.generated.props" />

  <!-- CsharpPrj 全产品闭包二进制引用（全子树 CSharpTest/AgentTest/TestInfrastructure 共享） -->
  <Import Project="$(MSBuildThisFileDirectory)build\props\CsharpPrj.BinaryRefs.props" />
</Project>