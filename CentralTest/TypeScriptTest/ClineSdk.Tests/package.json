{
  "name": "cline-sdk-tests",
  "private": true,
  "type": "module",
  "description": "Cline SDK 独立调用测试框架 —— 把「Cline 调用本身」从框架中剥离，独立复现/定位挂起与阶段，带进程级硬超时。",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:cli": "node src/run-all.mjs"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
