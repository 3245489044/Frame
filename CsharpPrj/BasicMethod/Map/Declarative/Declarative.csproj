<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BasicMethod.Declarative</RootNamespace>
    <AssemblyName>BasicMethod.Declarative</AssemblyName>
    <Description>通用声明式框架 - 提供 IDeclaration、IConstraint、IRelation、IDeclarativeMapper 等声明式编程基础能力。数学基础：关系代数 + 谓词逻辑 + 约束满足问题（CSP）</Description>
  </PropertyGroup>

  <!-- ★ 2026-07-18 添加 TConfig 引用：IDeclaration 继承 TConfig.Declarative.IDeclaration -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_TConfig)" />
  </ItemGroup>

</Project>
