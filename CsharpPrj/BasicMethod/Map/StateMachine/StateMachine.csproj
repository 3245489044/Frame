<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BasicMethod.StateMachine</AssemblyName>
    <RootNamespace>BasicMethod.StateMachine</RootNamespace>
    <PackageId>BasicMethod.StateMachine</PackageId>
    <Description>通用状态机基础框架 - 提供 Sequential / Lifecycle / AsyncEvent / Conditional 四种状态转换型状态机模式，以及 StateMachineStore / PauseManager / ScopeStateManager 等通用组件</Description>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <!-- 零外部依赖 - 纯 .NET 基础类库 -->

</Project>
