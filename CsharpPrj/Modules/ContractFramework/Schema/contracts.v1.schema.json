{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contracts/v1",
  "title": "ContractFramework 契约声明",
  "description": "以契约为语义的通用声明面；C#（ContractCatalog）与 PowerShell（Check-ContractRegistry.ps1）同读一份文件。字段权威见 Modules/ContractFramework/README.md。",
  "type": "object",
  "required": ["contracts"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/definitions/contract" }
    }
  },
  "definitions": {
    "contract": {
      "type": "object",
      "required": ["id", "semantics", "carrier", "tier", "effect", "evidence"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "契约标识（Family/Name[@Version]），跨文件唯一" },
        "invariant": { "type": "string" },
        "title": { "type": "string" },
        "semantics": { "type": "string", "minLength": 1 },
        "carrier": {
          "type": "object",
          "required": ["kind", "facts"],
          "properties": {
            "kind": { "type": "string", "enum": ["StructuralFact"] },
            "facts": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        },
        "tier": { "type": "string", "enum": ["Build", "Assembly", "Gate", "Runtime"] },
        "effect": { "type": "string", "enum": ["FailFast", "Block", "Heal", "Log"] },
        "host": {
          "type": "object",
          "required": ["kind", "impl"],
          "properties": {
            "kind": { "type": "string", "enum": ["DotNet", "Roslyn", "PowerGate", "Probe"] },
            "impl": { "type": "string", "minLength": 1, "description": "类型全名或仓库相对路径" }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["recomputeCmd", "positive", "negative"],
          "properties": {
            "recomputeCmd": { "type": "string", "minLength": 1 },
            "positive": { "type": "string", "minLength": 1 },
            "negative": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
