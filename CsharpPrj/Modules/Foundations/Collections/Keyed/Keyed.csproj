<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>键目录与选择内核（Keyed）</ModuleRule_Title>
    <ModuleRule_Layer>1</ModuleRule_Layer>
    <ModuleRule_Description>按域键组织描述/服务的纯数据结构内核：行式目录（键查找/必取）、显式序合并、域键分派、有序文本装配。零 IO、零时钟、零 ProjectReference（仅 BCL）。同键重复登记为装配期 fail-fast，禁止静默覆盖。</ModuleRule_Description>
    <ModuleRule_Keywords>键目录;KeyedCatalog;选择;分派;文本装配;纯数据结构</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="纯数据结构内核：不持宿主上下文、不做 IO/时钟/日志，命名空间 Modules.Foundations.Collections.Keyed" />
    <ModuleRule_Rule Include="同键重复登记必须 fail-fast：不得静默覆盖（防第二套声明漂移）" />
    <ModuleRule_Rule Include="选择/装配为纯函数：输入序即输出序，不丢行、不伪造缺失项" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Modules.Foundations.Collections.Keyed</RootNamespace>
    <AssemblyName>Modules.Foundations.Collections.Keyed</AssemblyName>
    <Description>键目录与选择内核 — 目录/显式序合并/域键分派/有序文本装配（纯逻辑，BCL-only）</Description>
  </PropertyGroup>

</Project>
