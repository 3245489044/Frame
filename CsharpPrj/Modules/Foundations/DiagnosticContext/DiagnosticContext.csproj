<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Modules.DiagnosticContext</RootNamespace>
    <AssemblyName>Modules.DiagnosticContext</AssemblyName>
    <Description>通用运行状态聚合框架 + 诊断通用组件（从 Share/Diagnostics 合并）</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="$(SystemTextJsonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <ProjectReference Include="$(Proj_Queue)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_Legacy/**/*.cs" />
    <None Include="_Legacy/**/*.cs" />
  </ItemGroup>

</Project>
