<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>路径边界校验内核</ModuleRule_Title>
    <ModuleRule_Layer>1</ModuleRule_Layer>
    <ModuleRule_Description>允许根包含 / 拒绝路径段匹配 / 路径归一的唯一内核：BCL-only、零 ProjectReference、纯函数；根包含与拒绝匹配共用同一"路径段"模型。</ModuleRule_Description>
    <ModuleRule_Keywords>路径;边界;允许根;拒绝段;归一</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="内核只依赖 BCL；不得 using Share.* / Operation.* / Agent.*（宿主路径一律由调用方归一后传入）" />
    <ModuleRule_Rule Include="根包含判定与拒绝匹配必须共用同一路径段模型：禁裸字符串前缀、禁子串 Contains" />
    <ModuleRule_Rule Include="空/非法输入按显式契约处理（空根不匹配任何路径），未知不回退为放行" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Modules.PathBoundary</AssemblyName>
    <RootNamespace>Modules.PathBoundary</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Description>路径边界校验内核 — 允许根包含 / 拒绝段匹配 / 归一（BCL-only）</Description>
  </PropertyGroup>

</Project>
