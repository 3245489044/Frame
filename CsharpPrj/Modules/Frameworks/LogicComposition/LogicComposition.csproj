<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.LogicComposition</RootNamespace>
    <AssemblyName>Share.LogicComposition</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>通用逻辑组合框架 — 提供与领域无关的合并、组合、插入、连接、验证抽象</Description>
  </PropertyGroup>

  <!-- LogicComposition 是独立项目，不依赖 FrameworkAbstractions -->
  <!-- 内部包含 ObjectMerger、TemplateConfigProvider 等自包含实现 -->
  <!-- 依赖 BasicMethod.Transformers 复用 GroupReducer、Validator、ITransformer 等基础能力 -->

  <ItemGroup>
    <!-- Transformers 已整合到 BasicMethod.csproj -->
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <!-- 转换内核（netstandard2.0 零依赖子工程）：可被 Roslyn 分析器间接复用，故不下沉进本工程 -->
    <ProjectReference Include="$(Proj_LogicComposition_Conversion)" />
    <!-- 运行期 JSON 出口：平台级 JSON 统一框架（转换内核为 netstandard2.0 零依赖，
         无法在分析器侧引用本模块；故「运行期」由 ConversionRuntime 桥接到 JsonMethod 单一出口） -->
    <ProjectReference Include="$(Proj_JsonMethod)" />
  </ItemGroup>

  <!-- 子工程源码不并入本工程（对齐 Plate\RoslynMethod.csproj 的排除范式） -->
  <ItemGroup>
    <Compile Remove="Conversion\**\*.cs" />
    <None Include="Conversion\**\*" />
  </ItemGroup>


</Project>
