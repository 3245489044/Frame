<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>MetaCommand</AssemblyName>
    <RootNamespace>MetaCommand</RootNamespace>
    <PackageId>MetaCommand</PackageId>
    <Description>通用元指令框架 - 领域无关的命令协议</Description>
    <Authors>MetaCommand Framework Team</Authors>
    <Version>3.0.0</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageTags>command;meta;workflow;middleware;di;logging</PackageTags>
    <RepositoryUrl>https://github.com/example/metacommand</RepositoryUrl>
    <License>MIT</License>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- 核心基础设施 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDependencyInjectionAbstractionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsLoggingVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsLoggingAbstractionsVersion)" />
    
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- 排除废弃代码目录 -->
  <ItemGroup>
    <Compile Remove="_Unused\**\*.cs" />
    <None Include="_Unused\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common、Logging、StateMachine 已整合到 BasicMethod.csproj -->
    <ProjectReference Include="..\..\BasicMethod\BasicMethod.csproj" />
    <ProjectReference Include="..\Parsing\Parsing.csproj" />
    <!-- TConfig 统一控件值读写接口 -->
    <ProjectReference Include="..\..\Plate\TConfig\TConfig.csproj" />
    <!-- Threading 框架（ReentryGuard 重入守卫） -->
    <ProjectReference Include="..\Threading\Threading.csproj" />
    <!-- ★ 2026-08-06 新增：值语义契约层（P4 单轨化）——WinFormsControlService 的控件值适配器表
         迁出为委托 ControlValueBridge（ValueContractRegistry），消除 MetaCommand 侧"每种 UI 单独适配"残留 -->
    <ProjectReference Include="..\ParameterResolver\ParameterResolver.csproj" />
    <!-- ★ WinForms 值语义后端：WinFormsControlService 默认后端 ControlValueBridge 已从 ParameterResolver 分离至此 -->
    <ProjectReference Include="..\..\Plate\WinFormsValueContract\WinFormsValueContract.csproj" />
  </ItemGroup>


</Project>
