<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>模块层</ModuleRule_Title>
    <ModuleRule_Layer>2</ModuleRule_Layer>
    <ModuleRule_Description>模块层聚合项目，包含组件数据、图处理、逻辑组合、元命令、节点框架、解析、管道、注册表等子模块</ModuleRule_Description>
    <ModuleRule_Keywords>模块,组件,图处理,逻辑,元命令,节点,解析,管道,注册表,线程</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是聚合项目，具体功能请查看其子项目" />
    <ModuleRule_Rule Include="子项目包括 ComponentData, DeclarativeDataflow, GraphProcessing, LogicComposition, MetaCommand, Node, Parsing, Pipeline, Registry" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要模块化功能组件时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块是聚合项目，具体实现在其子项目中" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Modules</RootNamespace>
    <AssemblyName>Modules</AssemblyName>
    <Description>Modules 聚合项目 - 引用 Modules 目录下所有子项目</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_ComponentData)" />
    <ProjectReference Include="$(Proj_DeclarativeDataflow)" />
    <ProjectReference Include="$(Proj_DiagnosticContext)" />
    <ProjectReference Include="$(Proj_EventFramework)" />
    <ProjectReference Include="$(Proj_ExecutionFramework)" />
    <ProjectReference Include="$(Proj_GraphProcessing)" />
    <ProjectReference Include="$(Proj_LogicComposition)" />
    <ProjectReference Include="$(Proj_MetaCommand)" />
    <ProjectReference Include="$(Proj_Node)" />
    <ProjectReference Include="$(Proj_Parsing)" />
    <ProjectReference Include="$(Proj_Pipeline)" />
    <ProjectReference Include="$(Proj_Registry)" />
    <ProjectReference Include="$(Proj_Threading)" />
    <ProjectReference Include="$(Proj_ParameterResolver)" />
    <ProjectReference Include="$(Proj_WinFormsValueContract)" />
    <ProjectReference Include="$(Proj_InternalStorage)" />
    <ProjectReference Include="$(Proj_ValidationFramework)" />
    <ProjectReference Include="$(Proj_Observe)" />
  </ItemGroup>

  <!-- 排除通过 ProjectReference 引用的子项目源代码，避免与 DLL 引用冲突 -->
  <ItemGroup>
    <Compile Remove="ComponentData\**\*.cs" />
    <Compile Remove="DeclarativeDataflow\**\*.cs" />
    <Compile Remove="DiagnosticContext\**\*.cs" />
    <Compile Remove="ExecutionFramework\**\*.cs" />
    <Compile Remove="GraphProcessing\**\*.cs" />
    <Compile Remove="LogicComposition\**\*.cs" />
    <Compile Remove="MetaCommand\**\*.cs" />
    <Compile Remove="Node\**\*.cs" />
    <Compile Remove="Parsing\**\*.cs" />
    <Compile Remove="Pipeline\**\*.cs" />
    <Compile Remove="Registry\**\*.cs" />
    <Compile Remove="Threading\**\*.cs" />
    <Compile Remove="ParameterResolver\**\*.cs" />
    <Compile Remove="InternalStorage\**\*.cs" />
    <Compile Remove="ValidationFramework\**\*.cs" />
    <Compile Remove="EventFramework\**\*.cs" />
    <Compile Remove="Observe\**\*.cs" />
  </ItemGroup>

</Project>


