<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>模块层</ModuleRule_Title>
    <ModuleRule_Layer>2</ModuleRule_Layer>
    <ModuleRule_Description>模块层聚合项目，按 Foundations/Data/Frameworks/Composition/Orchestration 五组组织：基础内核、数据与键空间、通用框架、组合接线、运行期编排</ModuleRule_Description>
    <ModuleRule_Keywords>模块,基础内核,数据,键空间,框架,组合,接线,编排,解析,管道,注册表,线程</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是聚合项目，具体功能请查看其子项目" />
    <ModuleRule_Rule Include="目录分组：Foundations / Data / Frameworks / Composition / Orchestration；新增模块须先归组再登记 modules.json" />
    <ModuleRule_Rule Include="子项目包括 ComponentData, DeclarativeDataflow, GraphProcessing, LogicComposition, MetaCommand, Node, Parsing, Pipeline, Registry" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要模块化功能组件时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块是聚合项目，具体实现在其子项目中" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Modules</RootNamespace>
    <AssemblyName>Modules</AssemblyName>
    <Description>Modules 聚合项目 - 引用 Modules 目录下所有子项目</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_ComponentData)" />
    <!-- 键目录与选择内核（Modules\Foundations\Collections\Keyed，L1、BCL-only）：行式目录/显式序合并/域键分派/有序文本装配；
         同键重复登记 fail-fast -->
    <ProjectReference Include="$(Proj_Keyed)" />
    <Compile Remove="Foundations\Collections\Keyed\**\*.cs" />
    <!-- 存储分页内核（Modules\Foundations\Storage，L1、BCL-only）：afterId 游标 + 页大小 + 最大页数护栏 -->
    <ProjectReference Include="$(Proj_Storage)" />
    <Compile Remove="Foundations\Storage\**\*.cs" />
    <!-- 通用计算基底（Modules\Foundations\Compute，L1、BCL + Modules.Threading）：扁平/SoA 布局、Arena/Scratch、
         3D cache-block 遍历、具名 SIMD 核、tile 调度、算子图编译；不含体素/群系语义 -->
    <ProjectReference Include="$(Proj_Compute)" />
    <!-- 通用并发策略内核（Modules\Foundations\Concurrency，L1、BCL-only）：复杂度/拆分/成本门禁/组键/成本记账；
         价格/容量/成本账经端口反转由宿主注入（零 Frame 依赖） -->
    <ProjectReference Include="$(Proj_Concurrency)" />
    <!-- 路径边界校验内核（Modules\Foundations\PathBoundary，L1、BCL-only）：允许根包含 / 拒绝段匹配统一为路径段模型 -->
    <ProjectReference Include="$(Proj_PathBoundary)" />
    <!-- 通用压力口径内核（Modules\Foundations\Regulation，L1、BCL-only）：上下文估算/EWMA/三维压力/
         迟滞/标量归一/跨轮进度追踪；零 ProjectReference，纯数值单源 -->
    <ProjectReference Include="$(Proj_Regulation)" />
    <!-- 序列单调校验内核（Modules\Foundations\Sequencing，L1、BCL-only）：序键单调判定 + 首个违序定位 -->
    <ProjectReference Include="$(Proj_Sequencing)" />
    <!-- 契约框架（Modules\Foundations\ContractFramework，BCL-only）：契约身份/注册/对账/执行/取证内核 -->
    <ProjectReference Include="$(Proj_ContractFramework)" />
    <ProjectReference Include="$(Proj_DeclarativeDataflow)" />
    <ProjectReference Include="$(Proj_DiagnosticContext)" />
    <ProjectReference Include="$(Proj_EventFramework)" />
    <ProjectReference Include="$(Proj_ExecutionFramework)" />
    <ProjectReference Include="$(Proj_GraphProcessing)" />
    <!-- 通用限制与治理内核（Modules\Foundations\Governance，BCL-only L2）：资源计量/作用域链/两相预留/统一裁决 -->
    <ProjectReference Include="$(Proj_Governance)" />
    <ProjectReference Include="$(Proj_Gather)" />
    <ProjectReference Include="$(Proj_Maintain)" />
    <ProjectReference Include="$(Proj_LogicComposition)" />
    <ProjectReference Include="$(Proj_MetaCommand)" />
    <ProjectReference Include="$(Proj_Node)" />
    <ProjectReference Include="$(Proj_Parsing)" />
    <!-- 键文法内核（Modules\Data\Parsing\Keys，BCL-only）：键空间单源；经本聚合工程纳入构建与烘焙闭包 -->
    <ProjectReference Include="$(Proj_Parsing_Keys)" />
    <ProjectReference Include="$(Proj_Pipeline)" />
    <ProjectReference Include="$(Proj_Registry)" />
    <!-- P2 插件宿主：宿主与中性契约同处 PluginHost 程序集（P1 RuntimeLayout 之上）。 -->
    <ProjectReference Include="$(Proj_PluginHost)" />
    <ProjectReference Include="$(Proj_Threading)" />
    <ProjectReference Include="$(Proj_ParameterResolver)" />
    <ProjectReference Include="$(Proj_WinFormsValueContract)" />
    <ProjectReference Include="$(Proj_InternalStorage)" />
    <!-- 键空间语义框架（Modules\Data\KeySpace，仅依赖 Parsing.Keys）：键族/身份/三态/集合策略/端口契约 -->
    <ProjectReference Include="$(Proj_KeySpace)" />
    <!-- 端口接盒通用框架（Modules\Composition\Wiring，仅依赖 KeySpace + Parsing.Keys）：声明式接线/供给闭合/单投递点 -->
    <ProjectReference Include="$(Proj_Wiring)" />
    <ProjectReference Include="$(Proj_ValidationFramework)" />
    <ProjectReference Include="$(Proj_Observe)" />
    <!-- 信号词表/判定/状态机内核（Modules\Frameworks\Signal，BCL-only，命名空间 Share.Signal 兼容既有消费端） -->
    <ProjectReference Include="$(Proj_Modules_Frameworks_Signal)" />
    <!-- 消息生命周期迁移表（Modules\Frameworks\Messaging，BCL-only，命名空间 Share.Messaging 兼容既有消费端） -->
    <ProjectReference Include="$(Proj_Modules_Frameworks_Messaging)" />
    <!-- 同步协议 MVP（Modules\Frameworks\Sync）：协议 v1 契约 + 进程内三端环路；下游仅经本聚合工程消费 -->
    <ProjectReference Include="$(Proj_Sync)" />
  </ItemGroup>

  <!-- 排除通过 ProjectReference 引用的子项目源代码，避免与 DLL 引用冲突 -->
  <ItemGroup>
    <Compile Remove="Data\ComponentData\**\*.cs" />
    <Compile Remove="Foundations\Compute\**\*.cs" />
    <Compile Remove="Foundations\Concurrency\**\*.cs" />
    <Compile Remove="Foundations\PathBoundary\**\*.cs" />
    <Compile Remove="Foundations\Regulation\**\*.cs" />
    <Compile Remove="Foundations\Sequencing\**\*.cs" />
    <Compile Remove="Foundations\ContractFramework\**\*.cs" />
    <Compile Remove="Data\DeclarativeDataflow\**\*.cs" />
    <Compile Remove="Foundations\DiagnosticContext\**\*.cs" />
    <Compile Remove="Frameworks\ExecutionFramework\**\*.cs" />
    <Compile Remove="Data\GraphProcessing\**\*.cs" />
    <Compile Remove="Foundations\Governance\**\*.cs" />
    <Compile Remove="Orchestration\Gather\**\*.cs" />
    <Compile Remove="Orchestration\Maintain\**\*.cs" />
    <Compile Remove="Frameworks\LogicComposition\**\*.cs" />
    <Compile Remove="Composition\MetaCommand\**\*.cs" />
    <Compile Remove="Data\Node\**\*.cs" />
    <Compile Remove="Data\Parsing\**\*.cs" />
    <Compile Remove="Composition\Pipeline\**\*.cs" />
    <Compile Remove="Composition\Registry\**\*.cs" />
    <Compile Remove="Orchestration\PluginHost\**\*.cs" />
    <Compile Remove="Foundations\Threading\**\*.cs" />
    <Compile Remove="Composition\ParameterResolver\**\*.cs" />
    <Compile Remove="Foundations\InternalStorage\**\*.cs" />
    <Compile Remove="Data\KeySpace\**\*.cs" />
    <Compile Remove="Composition\Wiring\**\*.cs" />
    <Compile Remove="Frameworks\ValidationFramework\**\*.cs" />
    <Compile Remove="Frameworks\EventFramework\**\*.cs" />
    <Compile Remove="Frameworks\Observe\**\*.cs" />
    <Compile Remove="Frameworks\Signal\**\*.cs" />
    <Compile Remove="Frameworks\Messaging\**\*.cs" />
    <Compile Remove="Frameworks\Sync\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 上行端口上下文内核（Modules\Foundations\PortContext，L1、BCL-only，命名空间 Share.PortContexts 兼容既有消费端） -->
    <ProjectReference Include="$(Proj_PortContext)" />
    <Compile Remove="Foundations\PortContext\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 文本段组合内核（Modules\Data\NodeText，L1、BCL-only，命名空间 Share.Composition.Text 兼容既有消费端） -->
    <ProjectReference Include="$(Proj_Modules_Data_NodeText)" />
    <Compile Remove="Data\NodeText\**\*.cs" />
  </ItemGroup>

</Project>


