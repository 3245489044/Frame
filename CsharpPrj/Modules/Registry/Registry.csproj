<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Share.Registry</AssemblyName>
    <RootNamespace>Share.Registry</RootNamespace>
    <Description>通用注册表框架 — 提供 6 种注册表模式：ISetRegistry / IMapRegistry / IFactoryRegistry / IMetaMapRegistry / IStageRegistry / IGraphRegistry + 事件通知 INotifyRegistry</Description>
  </PropertyGroup>

  <!-- 排除 _deprecated 文件夹，避免重复定义 -->
  <ItemGroup>
    <Compile Remove="_deprecated\**\*" />
    <None Include="_deprecated\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsDependencyInjectionVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <ProjectReference Include="$(Proj_TConfig)" />
    <ProjectReference Include="$(Proj_RoslynMethod_Core)" />
    <ProjectReference Include="$(Proj_CSG_Unified)" />

  </ItemGroup>

</Project>
