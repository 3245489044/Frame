<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinFormsValueContract</RootNamespace>
    <AssemblyName>WinFormsValueContract</AssemblyName>
    <AssemblyTitle>WinFormsValueContract</AssemblyTitle>
    <AssemblyDescription>WinForms 值语义后端 — 控件值契约具体实现（BuiltInValueContracts/ValueContractRegistry/ControlValueBridge/ControlTextNormalizer）+ WinForms 参数源。
      · 从 ParameterResolver 分离：ParameterResolver 保持 UI 无关（不再引用 WinForms）。
      · 消费方（MetaCommand/WorkFlowMethod/FrontEndDriven）依赖 TConfig.Controls.IControlService 抽象，本模块提供默认后端实现。</AssemblyDescription>
  </PropertyGroup>

  <ItemGroup>
    <!-- 值语义契约（TConfig.Controls：ValueSemantic/ControlValueContract/ValueAccessor/IControlService） -->
    <ProjectReference Include="..\..\Plate\TConfig\TConfig.csproj" />
    <!-- WinFormsControlSource 依赖 ParameterResolver 的 IParameterSource/IReadStrategy/Models（ParameterResolver 自身不引用 WinForms） -->
    <ProjectReference Include="..\ParameterResolver\ParameterResolver.csproj" />
    <!-- MarkdownViewer 控件值契约（markdownviewer → WebView2 SetMarkdownAsync 渲染） -->
    <ProjectReference Include="..\..\Plate\MarkdownViewer\MarkdownViewer.csproj" />

  </ItemGroup>

</Project>
