<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>端口接盒通用框架（Wiring）</ModuleRule_Title>
    <ModuleRule_Layer>2</ModuleRule_Layer>
    <ModuleRule_Description>声明式接线内核：Form/Port/Box/Wire/Adapter/Profile 声明 → 编译期供给闭合与形态校验 → 运行期唯一 Junction 投递与记账。BCL-only + 键空间语义内核（Modules.KeySpace）与键文法内核（Modules.Parsing.Keys），零领域词，不做工作流引擎/DI 容器/序列化。</ModuleRule_Description>
    <ModuleRule_Keywords>接线;端口;盒;声明式;供给闭合;单写者;编译期校验</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="连接唯一由 Wire 建立：禁同名隐式连接作为生产语义（W3）；inports/outports 仅为端口声明" />
    <ModuleRule_Rule Include="投递唯一入口 Junction + 账本唯一 IWireLedger（SingleImplementation / TH-12）；禁旁路直呼与第二份记录" />
    <ModuleRule_Rule Include="形态闭合：wire 两端 Form 必须相等或经已声明 Adapter；无 Form 的端口在 D2 报告中点名，禁静默 Text 兜底" />
    <ModuleRule_Rule Include="声明面不表达顺序（禁 order/step/then）：顺序归上层 [Flow]（DeclarativeProcessDisjoint）" />
    <ModuleRule_Rule Include="BCL-only + Modules.KeySpace + Modules.Parsing.Keys（仅此二者）；禁引 Strategy/Operation/Share/Projects（与 KeySpace 同纪律）" />
    <ModuleRule_Rule Include="零领域词：框架源码不出现 history/task/session/composer/page 等具体键名（I10）" />
    <ModuleRule_Rule Include="未装配即 Null 实现 + 可见化诊断（NoSilentOutlet）：missing-required 必须落账，禁静默跳过" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Modules.Wiring</RootNamespace>
    <AssemblyName>Modules.Wiring</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>端口接盒通用框架 — 声明式接线 + 编译期供给闭合 + 单一投递点</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 声明模型复用（DeclarationKind/PortBinding/BindingManifest/ImplementationCatalog/ClosureValidator 单源）：不另建第二套声明模型。 -->
    <ProjectReference Include="$(Proj_KeySpace)" />
    <ProjectReference Include="$(Proj_Parsing_Keys)" />
  </ItemGroup>

</Project>
