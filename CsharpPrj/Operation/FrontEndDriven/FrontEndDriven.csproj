<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FrontEndDriven</RootNamespace>
    <AssemblyName>FrontEndDriven</AssemblyName>
    <Description>通用前端驱动框架 — 提供控件查找、值读写、注册、统一服务等前端通用能力。WinForms 强相关逻辑已分离到 WinForms/ 子目录。</Description>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- 抽象接口层 -->
    <ProjectReference Include="$(Proj_CommandFramework)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />

    <!-- 基础框架 -->
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <ProjectReference Include="$(Proj_MetaCommand)" />

    <!-- ★ 2026-08-06 新增：值语义契约层（IControlService 实现：ControlValueBridge/ValueContractRegistry）——
         EcsStateAccessor/InputCapturePort 按契约读写/订阅，删除控件类型特判（ListView 等） -->
    <ProjectReference Include="$(Proj_ParameterResolver)" />
    <!-- ★ WinForms 值语义后端：ControlValueBridge/ValueContractRegistry 已从 ParameterResolver 分离至此 -->
    <ProjectReference Include="$(Proj_WinFormsValueContract)" />

    <!-- ★ 2026-08-11 新增：验证引擎对齐——EntityValidationEngine 委托到通用 ValidationFramework（消除自造验证器） -->
    <ProjectReference Include="$(Proj_ValidationFramework)" />

    <!-- 共享框架 -->
    <ProjectReference Include="$(Proj_PlaceholderFramework)" />
    <ProjectReference Include="$(Proj_UniversalMiddleware)" />
    <!-- 表面光栅原语（噪声/径向掩膜/模糊/圆角）：载体无关，本载体只做装配 -->
    <ProjectReference Include="$(Proj_Share_SurfaceRaster)" />
    <!-- 表面绘制内核（几何/边框/缓存键/逐层落笔）：载体无关，本载体只做生命周期与映射 -->
    <ProjectReference Include="$(Proj_Share_SurfacePaint)" />
    <!-- 诊断框架（FrameworkErrors、FrameworkErrorEventArgs） -->
    <ProjectReference Include="$(Proj_Diagnostics)" />


    <!-- ConfigurationModels（UIConfiguration、ControlConfig 等配置模型） -->
    <ProjectReference Include="$(Proj_Share_ConfigurationModels)" />

    <!-- EventBindingOrchestrator（IRenderPipeline、ContainerBinderPipeline 等事件绑定管线） -->
    <ProjectReference Include="$(Proj_EventBindingOrchestrator)" />
    <!-- Modules.Registry（[FunctionLibrary]/ITrConfigRegistry，UiCatalogLibrary 通用目录函数注册） -->
    <ProjectReference Include="$(Proj_Registry)" />
    <!-- TConfig 统一控件值读写接口 -->
    <ProjectReference Include="$(Proj_TConfig)" />

    <!-- InternalStorage（StorageCell — EcsRenderPipeline 内部创建默认 IStorageCell 实例） -->
    <ProjectReference Include="$(Proj_InternalStorage)" />

    <!-- ComponentData（组件数据存储、反应器链、生命周期管理） -->
    <ProjectReference Include="$(Proj_ComponentData)" />
    <!-- LayoutAnalysis（共享布局分析：控件遍历、重叠检测等） -->
    <ProjectReference Include="$(Proj_LayoutAnalysis)" />

    <!-- 收敛控制律内核（Modules\Foundations\Regulation，L1、BCL-only）：LayoutScheduler 的风暴护栏 +
         按键预算耗尽重试/终态隔离（ConvergenceController）；阈值仍由 LayoutConvergencePolicy 注入 -->
    <ProjectReference Include="$(Proj_Regulation)" />

    <!-- 可重入事件派发队列（Modules\Frameworks\EventFramework\Bus）：EcsEventBus 的单消费者守卫 +
         重入入队 + 统一 drain（ReentrantEventDispatchQueue<T>），事件绑定语义仍留在本工程 -->
    <ProjectReference Include="$(Proj_EventFramework)" />
    <!-- 调用面契约内核（声明/绑定/命名空间索引）：加载期校验与运行期寻址共用同一判据载体 -->
    <ProjectReference Include="$(Proj_Parsing)" />

  </ItemGroup>

  <!-- ★ 2026-07-25 新增：Threading（通用执行状态结果类 ExecutionResult/StepRecord/ExecutionPhase） -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_Threading)" />
  </ItemGroup>

  <!-- ★ 2026-07-23 新增：命令执行子系统依赖 -->
  <!-- ★★ 2026-08-02 清理：命令系统残留迁移/删除后，Pipeline/Container/ExecutionFramework
       在 FrontEndDriven 内零使用，移除引用（权威依据：重构方案 Phase 3 §3.1） -->

  <!-- ★ 2026-09-17 新增（管线化重构 Q0-1 / X1 收口）：`Initial\RenderPipeline` 三件
       （RenderPipelineStages / RenderStageRunner / RenderValidationStage）使用 `Modules.Pipeline`
       （StagePipeline / IPipelineStage / PipelineContext）；此前该依赖仅经 PlaceholderFramework /
       UniversalMiddleware / StateManagement / EventBindingOrchestrator **传递**获得（隐式依赖）。
       显式声明后：新增 Pipeline 用法即同批声明，R2 棘轮用例机器校验。 -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_Pipeline)" />
  </ItemGroup>

  <!-- ★ 2026-08-05 新增：通用控件查找框架（Share.ControlLookup）——ControlRegistryAwareFinder 多级查找收敛为「查找源 + 聚合器」 -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_ControlLookup)" />
  </ItemGroup>

  <!-- ★ 2026-08-05 新增：StateCenter 契约 + 中心实现（Provider 接线）——StateHoldDriven 不引用 FrontEndDriven（R2），反向单向依赖 -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_StateManagement)" />
    <ProjectReference Include="$(Proj_StateHoldDriven)" />
    <!-- TaskPoolMarkdownRenderer（FrontEndDriven.Rendering）：ur_tasks 分页 → md 渲染（依赖 TaskPoolRowView/TaskExecutionStatus） -->
    <ProjectReference Include="$(Proj_TaskStatusPool)" />

    <ProjectReference Include="$(Proj_MarkdownViewer)" />
    <!-- ★ 2026-08-22 新增：HtmlViewer（可信富文本通道，htmlviewer 控件类型）——与 MarkdownViewer 平级独立模块；
         ★ 2026-08-24 HTML 后端逻辑并入 HtmlViewer（IUiElementNode/IDomBridge 等类型驻留 Plate.HtmlViewer），WinFormsElementNode 复用 -->
    <ProjectReference Include="$(Proj_HtmlViewer)" />

    <!-- 2026-11-07 新增：表面色值编解码单点（UiBackend.SurfaceColor，Plate.Surface，BCL-only）——
         CSS 8 位 hex（RRGGBBAA）与 GDI+ ARGB（AARRGGBB）的错位只在那一处转换，WinForms 画笔不再自行解释 -->
    <ProjectReference Include="$(Proj_Plate_Surface)" />

    <!-- ★ 2026-09 依赖倒置（DIP）连接层：HtmlViewerBridge（Observe 收敛写 ObservedHtmlChannel/WebView2Transport + Conversation
         会话渲染 HtmlStreamRenderer 的真实宿主落点）——本层作为「能同时看见 HtmlViewer × Observe × Conversation 的中性连接层/组合根」，
         倒转 plate→上游 污染为 上层(FrontEndDriven)→plate 抽象。Observe/Share.Conversation 均为 leaf 子项目，无环。 -->
    <ProjectReference Include="$(Proj_Observe)" />
    <ProjectReference Include="$(Proj_Share_Conversation)" />

    <!-- ★ 2026-09-11 通用 HTML 宿主门面（FrontEndDriven.HtmlHosting）：HtmlUiHost 插槽宿主复用 Share.HostAssembly 的
         ThreadSafeSlot（唯一实现，勿复制锁槽样板）；HtmlBridgeAssembly 的配置模板加载复用 Plate.JsonMethod 节点读取。 -->
    <ProjectReference Include="$(Proj_HostAssembly)" />
    <ProjectReference Include="$(Proj_JsonMethod)" />

    <!-- ★ 2026-10-15 通用刷新框架（Strategy.Refresh）：写仲裁适配器 RefreshWriteArbiter 的单一状态源
         （IRefreshStore/InMemoryRefreshStore）——刷新语义唯一 owner，写落地决策上移框架。
         （上迁说明：原 Share.RefreshFramework 通用原语已上迁 Strategy.Refresh（Share 侧工程已回收）。） -->
    <ProjectReference Include="$(Proj_Refresh)" />

    <!-- ★ 2026-10-15 通用分级查询框架（Strategy.Catalog，L3 向下引用合规）：模板目录（templates source）接入 -->
    <ProjectReference Include="$(Proj_Catalog)" />
    <!-- 聚拢通用框架（Modules.Gather，L1 通用内核）：Need/Stage/Produce 声明模型 + GatherHub（唯一读写面）；
         本层（Operation/L4）只做 UI 适配（UiViewProjection 薄转发），通用语义不下沉到驱动层 -->
    <ProjectReference Include="$(Proj_Gather)" />
  </ItemGroup>
  <ItemGroup>
    <!-- 废弃迁移（project.md §2 compile_exclude）：AttachProjector/RowModels 零生产引用，保留可追溯。 -->
    <Compile Remove="_deprecated\**\*" />
    <Compile Remove="HtmlViewerBridge\Projection\_deprecated\**\*" />
    <None Include="HtmlViewerBridge\Projection\_deprecated\**\*" />
  </ItemGroup>

</Project>

