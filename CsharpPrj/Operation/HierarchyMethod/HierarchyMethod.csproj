<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>层次方法通用框架（HierarchyMethod）</ModuleRule_Title>
    <ModuleRule_Layer>4</ModuleRule_Layer>
    <ModuleRule_Description>nodes / task / history 三层通用、LLM-free 基础框架：HierarchyMethod.Nodes（节点存储/输出/关系编排）、HierarchyMethod.Tasks（纯簿记 + 执行节点 + 循环快照根 + 注入端口）、HierarchyMethod.History（历史容器/消息日志/关系编排）。零 Agent 依赖，LLM 知识仅经注入端口由 Agent 应用层提供。</ModuleRule_Description>
    <ModuleRule_Keywords>HierarchyMethod;Nodes;Tasks;History;LLM-free;NodeRecord;TaskRecord;HistoryRecord;端口注入;可空守卫</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="三层单向依赖：Nodes → Tasks → History（通用、LLM-free）；Agent 消费、不反向依赖" />
    <ModuleRule_Rule Include="框架本体零 LLM 依赖；LLM 知识（执行器/导演/提示词）只能存在于 Agent 应用层，经注入端口提供" />
    <ModuleRule_Rule Include="写边原语唯一收敛 DataStoreDriven.ReferenceGraphCoordinator，编排只编排不复制写边（SingleImplementation / TH-12）" />
    <ModuleRule_Rule Include="未装配端口/关系库返回空集/诊断（UnavailableDiagnostics），不消耗 AI 额度、不阻断 DB-only 路径" />
    <ModuleRule_Rule Include="层次结构外置：层数/层名/包含关系由 Modules.DeclarativeDataflow 的 HierarchySchema 声明（Hierarchy/Dataflow/HierarchySchemas），遍历/护栏/子结论收敛复用它，不硬编码层遍历" />
    <ModuleRule_Rule Include="电路接入面唯一收敛（P1）：RoundSpec 中立原语 → CircuitRecipeSpec 投影/缓存/步骤节点下沉 Nodes\Circuit（RoundFlowSpecMapper / RoundFlowCircuitRegistry / RoundStepCircuitNode），全消费方共享唯一函数调用链（唯一编译入口 = CircuitCompiler.TryCompile）；RoundSpec 字段保持中立（不得写入框架类型），宿主语义胶水（AgentLog 等）留上层" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Operation.HierarchyMethod</RootNamespace>
    <AssemblyName>Operation.HierarchyMethod</AssemblyName>
    <Description>nodes/task/history 三层通用、LLM-free 基础框架（HierarchyMethod）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 任务池/状态机/循环引擎/确定性核心（TaskStatusPool.TaskPool / Loops / Routing） -->
    <ProjectReference Include="$(Proj_Threading)" />
<ProjectReference Include="$(Proj_TaskStatusPool)" />
    <!-- 支撑 DTO（SchedulingMode/DataSpace/DataContract/RuntimeSnapshot，LLM-free 纯数据）；源文件随 HierarchySupport 叶工程并入 Strategy\Observability，命名空间 Share.HierarchySupport 保留 -->
    <ProjectReference Include="$(Proj_Observability)" />
    <!-- 会话消息日志纯逻辑（ConversationLog/ConversationMessage/IHistoryStore） -->
    <ProjectReference Include="$(Proj_Share_Conversation)" />
    <!-- 节点库/关系库/写边原语（NodeStore/NodeRelationStore/ReferenceGraphCoordinator） -->
    <ProjectReference Include="$(Proj_DataStoreDriven)" />
    <!-- AI 调度状态门面（IStateFacet 等共享状态视图，纯数据/端口） -->
    <ProjectReference Include="$(Proj_AiScheduling)" />
    <!-- 工作流上下文/循环框架（WorkflowContext/LoopFramework 领域内核类型） -->
    <ProjectReference Include="$(Proj_WorkFlowMethod)" />
    <!-- 通用 JSON 条件判定内核（JsonRuleEngine，LLM-free）：HierarchyMethod.Rules 规则评估引擎委托 -->
    <ProjectReference Include="$(Proj_Parsing)" />
    <!-- 引用空间抽象（LoopFoldMethod.Reference）：HistoryRelationManager 等编排门面转发到 Reference.Gateways（单一 owner），
         消费方端口（IHistoryRelationManager 等）形态不变；LoopFoldMethod 不反向依赖本模块，无环。 -->
    <ProjectReference Include="$(Proj_LoopFoldMethod)" />
    <!-- 平台级统一 JSON 框架（Plate.JsonMethod）：节点输出载荷编解码统一编码（非 ASCII 直出，避免 \uXXXX 转义污染存储） -->
    <ProjectReference Include="$(Proj_JsonMethod)" />
    <!-- 声明式多层处理框架（层次外置 schema + 递归引擎 + 三重护栏）：Hierarchy/Dataflow 层遍历不再手写；单向依赖，框架零项目引用 -->
    <ProjectReference Include="$(Proj_DeclarativeDataflow)" />
    <!-- ★ 2026-09-17 新增（管线化重构 Q0-1 / X1′ 收口，由 R2 棘轮用例发现）：
         Nodes\Execution\NodeStepExecutionService.cs 使用 `Modules.Pipeline.StepExec`（步骤执行中间件），
         此前该依赖经 WorkFlowMethod 等**传递**获得（隐式依赖）；显式声明后由守卫机器校验。 -->
    <ProjectReference Include="$(Proj_Pipeline)" />
  </ItemGroup>

  <!-- ★ 2026-10-03 P1（HierarchyMethod → CircuitFramework 电路接入面下沉）：
       中立投影/缓存/步骤节点（RoundFlowSpecMapper / RoundFlowCircuitRegistry / RoundStepCircuitNode）
       下沉至 Nodes\Circuit，作为全消费方唯一电路接入面（RoundSpec 中立原语 → CircuitRecipeSpec → 编译 → 引擎）；
       本模块层 4 → Share.CircuitFramework 层 2，属向下引用（先例：$(Proj_DeclarativeDataflow)）。 -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_CircuitFramework)" />
  </ItemGroup>

  <!-- ★ 2026-10-03 E2（HierarchyMethod\Nodes → Modules.Node 通用框架提取）：
       收集式输入端口 token / 整包条目（CollectedNodePort）改委托框架唯一实现（键空间「整包」扩展）；
       本模块层 4 → Modules.Node 层 2，属向下引用（先例：WorkFlowMethod.csproj → $(Proj_Node)）。 -->
  <ItemGroup>
    <ProjectReference Include="$(Proj_Node)" />
  </ItemGroup>

</Project>
