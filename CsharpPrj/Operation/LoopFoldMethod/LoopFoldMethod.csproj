<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>状态折叠框架 LoopFoldMethod（以折叠替代循环）</ModuleRule_Title>
    <ModuleRule_Layer>4</ModuleRule_Layer>
    <ModuleRule_Description>Agent 无关、LLM-free 的通用状态折叠框架（使用层）：以折叠（fold/unfold）为第一抽象，把单个状态点按外部结论逐点铺成有序状态带并在边界截断。Fold/ 为公开折叠面（FoldEngine/FoldResult/FoldTrace/FoldVertex/FoldCut/FoldBudget），Operator/ 为唯一外部驱动面（IFoldOperator/FoldContext/FoldStep），FoldHead/（IFoldHeadProjector 折叠前缀→判定点）、Cutoff/（ICutoffPolicy 截断执法）、Select/（FoldDecision 确定性终决）、Attempt/（IFoldObserver 观测）。Adapters/ 为算子层复用接缝（方案 A 薄适配）：EvolverFoldOperator/ConvergerCutoffPolicy/IntegratorFoldHead 引用 BasicMethod.Calculus 算子（IEvolver/IConverger/IIntegrator），只引算子不迁移引擎，EvolveUntilConverged 不充当 FoldEngine。Reference/ 为平行第二抽象（空间/结构关系中立面）：Model/（ReferenceTypes 边类型唯一常量源 + IHierarchyContainer 层级容器 + ReferenceEdge/ReferenceVisibility）、Derivation/（ScopeResolver/TreeHeadProjector/EdgeDeriver 纯推演 LLM-free）、Projection/（IRefProjector + RefHead 默认投影，对齐折叠头思想）、Gateways/（HistoryRelationGateway 等中性编排 owner，只编排/投影/纯推演，写边唯一 owner 留 DataStoreDriven）。Node/ 为第三个平行抽象（动态节点装配，通用非提示词强相关）：Model/（NodeCategory/NodeSlot/NodeItem 通用载荷节点，不落库）、Source/（INodeSource + AggregateNodeSource 收集端口）、Assemble/（INodeSlotPolicy 槽位策略扩展点 + CacheStableSlotPolicy 通用稳定前缀策略 + NodeBuilder 纯函数编排 → NodeAssembly 头/中/尾三段）、Project/（INodeProjector 投影端口）。提示词注入等消费域为 Node 框架的应用（语义源 + 槽位策略 + 投影器在 Agent 侧实现），框架本体零 LLM、Agent 无关。Node/Component/ 为组件单一声明层（NodeComponent 一次声明「提示词源+声明式工具元数据 ComponentToolSpec+执行端键 ExecutorKey」；INodeComponentRegistry/NodeComponentRegistry 唯一登记落点、同名 fail-fast，防"第二套描述漂移"），Node/Session/ 为装配引擎层（INodeAssemblyEngine/NodeAssemblyEngine 把「组件单一声明 + 动态上下文节点」装配为一致多面产物 AssemblyOutcome——装配三段 + 命中/未注册诊断 + 组件工具面，端到端唯一入口；子智能体/task/history 的差异=注入的注册表与动态源不同，非各写一套拼装，对齐 TH-12）。本模块为纯折叠框架，不承载循环兼容层/租约端口/导演解析（已彻底移除）。决策域权威（LoopDecision/EvalOutcome/SnapshotDrivenLoopEngine）保留在 Share.TaskStatusPool，本模块仅引用不重复定义（FoldEngine 复用 SnapshotDrivenLoopEngine，TH-12 单一实现）。另，Contracts/Core/Routing 为通用有界脊柱管道（与 Fold/Reference/Node 平行的第四抽象，Agent 无关）：八作用点固定顺序（ActionStageId/SpinalStageOrder.Fixed）x 每级路由分发（IActionRouter/IActionHandler/RouteTable），ActionPoint 有界守卫，底层 while 复用 SnapshotDrivenLoopEngine（TH-12 单一实现）；不承载 Agent 导演/租约/调度语义（留消费侧 Agent 注册 Router/Handler）。</ModuleRule_Description>
    <ModuleRule_Keywords>状态折叠;FoldEngine;FoldCut;FoldHead;IFoldOperator;ICutoffPolicy;FoldDecision;Adapters;Calculus;EvolverFoldOperator;ConvergerCutoffPolicy;IntegratorFoldHead;Reference;ReferenceTypes;IRefProjector;RefHead;ScopeResolver;TreeHeadProjector;EdgeDeriver;HistoryRelationGateway;LLM-free;Agent无关;unfold;Node;NodeItem;NodeCategory;NodeSlot;NodeBuilder;INodeSlotPolicy;CacheStableSlotPolicy;INodeSource;AggregateNodeSource;INodeProjector;NodeAssembly;NodeComponent;INodeComponentRegistry;NodeComponentRegistry;ComponentToolSpec;ComponentToolFace;INodeAssemblyEngine;NodeAssemblyEngine;AssemblyScope;AssemblyRequest;AssemblyOutcome</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是 Operation 层的纯状态折叠框架，完全 Agent 无关、LLM-free（不引用任何 Agent 项目，不认识 AgentTaskItem/Cline/Answer）" />
    <ModuleRule_Rule Include="Fold/ 为公开折叠面（unfold 宿主 + 折叠头 + 截断执法），唯一控制循环推进处；Operator/ 的 IFoldOperator 是唯一外部驱动面（LLM/规则/人审皆实现），LLM 只是算子实现之一，框架不强制 LLM" />
    <ModuleRule_Rule Include="信任反转：预算/截断/收敛/空值守卫是折叠器对不可信外部算子的强制执法层，不信任算子自停（ICutoffPolicy + FoldEngine 空值守卫）" />
    <ModuleRule_Rule Include="决策域权威（LoopDecision/EvalOutcome/SnapshotDrivenLoopEngine）保留在 Share.TaskStatusPool，本模块仅引用不重复定义（Share→Operation 分层约束；FoldEngine 复用 SnapshotDrivenLoopEngine 不做第二套 while）" />
    <ModuleRule_Rule Include="本模块不承载导演/租约/循环兼容层（Agent 调度导演与租约派生/收割是 Agent 侧关注点，迁至 Agent.Core 消费方）" />
    <ModuleRule_Rule Include="Reference/ 为与 Fold 平行的第二抽象（空间/结构），语义正交不包含：只做抽象 + 编排 + 纯推演，写边原语唯一 owner 留 DataStoreDriven 图协调器（IReferenceMaintenance 单一守卫），不复制任何写边逻辑（TH-12）；防「顺手把图逻辑塞进算子」的隐性耦合是第一纪律" />
    <ModuleRule_Rule Include="Reference 纯推演（ScopeResolver/TreeHeadProjector/EdgeDeriver）保持静态纯函数，可在零 AI 额度纯 CI 测试；Reference 不反向依赖 HierarchyMethod（防环：HierarchyMethod 经 Reference.Gateways 转发）" />
    <ModuleRule_Rule Include="Node/ 为与 Fold/Reference 平行的第三抽象（动态节点装配）：只做收集/编排/投影（Model/Source/Assemble/Project），不含任何提示词/LLM/Agent 语义；提示词注入等消费域作为其应用（语义源 + 槽位策略 + 投影器在 Agent 侧实现），不塞进框架；Node 纯编排（NodeBuilder/CacheStableSlotPolicy）保持静态纯函数，可在零 AI 额度纯 CI 测试" />
    <ModuleRule_Rule Include="Node/Component 为组件单一声明层：NodeComponent 一次声明「提示词源+声明式机器工具元数据(ComponentToolSpec)+确定性执行端键(ExecutorKey)」，使提示词面/机器工具面/执行端绑定同源于一次声明（对齐分析文档 IAgentSkillAssembly 收敛，泛化到框架）；INodeComponentRegistry/NodeComponentRegistry 为唯一登记落点、同名重复登记 fail-fast（防第二套描述漂移，TH-12）" />
    <ModuleRule_Rule Include="Node/Session 为端到端唯一装配入口（NodeAssemblyEngine/INodeAssemblyEngine）：从 Node/Component 注册表解析 AlwaysOn+点名组件、合并动态上下文节点、经 NodeBuilder 排布为头/中/尾三段、产出 AssemblyOutcome（装配+命中/未注册诊断+组件工具面）；只装配不推进循环（步进留折叠引擎）；子智能体/task/history 的差异=注入的注册表与动态源不同，非各写一套拼装（TH-12）" />
    <ModuleRule_Rule Include="装配框架零 LLM/Agent 无关红线：Node/Component 与 Node/Session 只持字符串/声明式元数据（ComponentToolSpec/ExecutorKey），不得出现 LlmTool/SkillDefinition/AgentTaskItem 等消费域类型；工具面只到元数据，具象化为 LLM 工具/执行器留消费侧唯一 binder；动态语义（历史/task 内容）经 INodeSource 或动态节点由消费侧注入" />
    <ModuleRule_Rule Include="Contracts/Core/Routing 为第四平行抽象——通用有界脊柱管道：八作用点固定顺序（SpinalStageOrder.Fixed）按每级路由分发（IActionRouter→IActionHandler），Agent 无关 LLM-free；底层 while 与决策权威复用 Share.TaskStatusPool.Loops（TH-12 单一实现），本模块不另写循环、不重复定义 LoopDecision；Decide/Terminate 语义由宿主 handler 复用 TaskStatusPool 权威，框架只占固定顺序、有界、收敛" />
    <ModuleRule_Rule Include="脊柱作用点有界守卫归一 Modules.Threading.Bounded（ActionPoint 单次 HandleAsync 经 BoundedExecution 有界执行）：协作取消 + 自身预算耗尽抛 BoundedTimeoutException → 作用点收敛为 LoopDecision.Timeout 终态（预算终止引擎内裁决）；外层取消一律上抛不误报超时；本模块不另写 linked-CTS/CancelAfter 内联守卫（TH-12）" />

    <ModuleRule_Rule Include="脊柱依赖方向恒单向：Routing→Core→Contracts；禁止 LoopFoldMethod→Agent.*/HierarchyMethod（HierarchyMethod 反向引用 LoopFoldMethod，防环）；固定层只认类型化 Port（IActionHandler/IActionRouter），自由逻辑只能存于 handler（可度量审计：任一步出现随策略变化的支路集合即上提）" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要状态折叠（unfold/截断/折叠头/收敛）通用框架时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块的 Fold/ 包含 FoldEngine/FoldResult/FoldTrace/FoldVertex/FoldCut/FoldBudget；Operator/ 包含 IFoldOperator/FoldContext/FoldStep；FoldHead/ 包含 IFoldHeadProjector；Cutoff/ 包含 ICutoffPolicy；Select/ 包含 FoldDecision；Attempt/ 包含 IFoldObserver" />
    <ModuleRule_Prompt Include="此模块的 Node/ 包含 NodeItem/NodeCategory/NodeSlot（Model）、INodeSource/AggregateNodeSource（Source）、INodeSlotPolicy/CacheStableSlotPolicy/NodeBuilder/NodeAssembly（Assemble）、INodeProjector（Project）；要动态装配一组通用节点（稳定前缀/多变后缀排布，非提示词强相关）优先查看" />
    <ModuleRule_Prompt Include="此模块的 Node/Session 包含 INodeAssemblyEngine/NodeAssemblyEngine（唯一装配入口）、AssemblyScope/AssemblyRequest/AssemblyOutcome；Node/Component 包含 NodeComponent/INodeComponentRegistry/NodeComponentRegistry/ComponentToolSpec/ComponentToolFace；需要「一次声明 → 一致的提示词面+机器工具面+执行端绑定」的通用装配框架（子智能体/task/history 复用）优先查看" />
    <ModuleRule_Prompt Include="此模块的 Contracts/Core/Routing 包含通用脊柱管道：Contracts/（ActionStageId 八作用点 + SpinalStageOrder.Fixed + ActionCall/HandlerOutcome）、Routing/（IActionRouter/IActionHandler/RouteTable）、Core/（ISpinalPipeline/SpinalPipeline/ActionPoint/SpinalDecisions）；需要「固定顺序脊柱 按 每级路由分发」的通用有界推进框架优先查看" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Operation.LoopFoldMethod</RootNamespace>
    <AssemblyName>Operation.LoopFoldMethod</AssemblyName>
    <Description>通用状态折叠框架 — Agent 无关、LLM-free 的纯折叠（unfold/截断/折叠头/收敛）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 决策域权威（LoopDecision/SnapshotDrivenLoopEngine）：Share.TaskStatusPool.Loops（唯一依赖，纯折叠无调度耦合） -->
    <ProjectReference Include="$(Proj_TaskStatusPool)" />

    <!-- 算子层复用（BasicMethod.Calculus，方案 A 薄适配）：Adapters/ 三个适配器引用其算子（IEvolver/IConverger/IIntegrator）；
         只引算子不迁移引擎，EvolveUntilConverged 不充当 FoldEngine（引擎推进仍在 FoldEngine/SnapshotDrivenLoopEngine） -->
    <ProjectReference Include="$(Proj_Calculus)" />

    <!-- 引用空间抽象（Reference/）：边类型常量委托 + 写边原语/读边端口（IReferenceMaintenance / IResourceReferenceStore）。
         Reference 只编排/投影/纯推演，写边唯一 owner 仍在 DataStoreDriven 图协调器（TH-12），本引用仅消费其契约。 -->
    <ProjectReference Include="$(Proj_DataStoreDriven)" />

    <!-- 有界守卫归一（A₀）：ActionPoint 单次 HandleAsync 的有界执行上收 Modules.Threading.Bounded（BoundedExecution，
         协作取消 + 自身预算耗尽抛强类型 BoundedTimeoutException；外层取消一律上抛 OCE 不误报超时）。Threading 为叶子模块，无环。 -->
    <ProjectReference Include="$(Proj_Threading)" />
  </ItemGroup>

</Project>
