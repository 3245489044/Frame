<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>操作层</ModuleRule_Title>
    <ModuleRule_Layer>4</ModuleRule_Layer>
    <ModuleRule_Description>操作实现层聚合项目，包含事件触发框架、函数存储、WdUI、工作流方法等子模块</ModuleRule_Description>
    <ModuleRule_Keywords>操作,事件触发,函数存储,UI,工作流</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是聚合项目，具体功能请查看其子项目" />
    <ModuleRule_Rule Include="子项目包括 EventTriggerFramework, FunctionStorage, WdUI, WorkFlowMethod" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要操作实现、事件触发、UI 自动化、工作流方法等功能时，优先查看此模块" />
    <ModuleRule_Prompt Include="此模块的 WdUI/ 包含 UI 自动化相关功能" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Operation</RootNamespace>
    <AssemblyName>Operation</AssemblyName>
    <Description>Operation 聚合项目 - 引用 Operation 目录下所有子项目</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_FrontEndDriven)" />
    <ProjectReference Include="$(Proj_BackEndDriven)" />
    <ProjectReference Include="$(Proj_WorkFlowMethod)" />
    <ProjectReference Include="$(Proj_StateHoldDriven)" />
    <ProjectReference Include="$(Proj_DataStoreDriven)" />
    <ProjectReference Include="$(Proj_HierarchyMethod)" />
    <ProjectReference Include="$(Proj_LoopFoldMethod)" />
  </ItemGroup>

  <!-- 排除通过 ProjectReference 引用的子项目源代码，避免与 DLL 引用冲突 -->
  <ItemGroup>
    <Compile Remove="FunctionStorage\**\*.cs" />
    <Compile Remove="WorkFlowMethod\**\*.cs" />
    <Compile Remove="StateHoldDriven\**\*.cs" />
    <Compile Remove="BackEndDriven\**\*.cs" />
    <Compile Remove="FrontEndDriven\**\*.cs" />
    <Compile Remove="HierarchyMethod\**\*.cs" />
    <Compile Remove="LoopFoldMethod\**\*.cs" />
    <!-- ★ DataStoreDriven 亦为独立子项目（Operation.DataStoreDriven），聚合项目经 ProjectReference 引用，
         须排除其目录源码避免 IDataStore/IPersistenceStore 等类型在 Operation.dll 中重复编译（CS0433）。 -->
    <Compile Remove="DataStoreDriven\**\*.cs" />
  </ItemGroup>

</Project>


