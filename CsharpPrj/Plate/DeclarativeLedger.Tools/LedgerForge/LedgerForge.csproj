<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       LedgerForge —— 声明式台账**离线写入器**（F2-a 生成式进框架）。
       定位：对标 Plate\RoslynMethod.Tools\ClearCSharpComments（Program.cs 独立入口，
       不进 Plate 伞聚合、不进 MainProj.sln —— 离线工具工程）。
       红线：写入只准离线工具；DataCenter.Standards 仍零 IO、零写入；装载期绝不写盘。
       依赖：Plate.JsonMethod（平台 JSON 机制唯一实现）+ BasicMethod.Declarative.Ledger（判据机制）。
       ============================================================ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>LedgerForge</AssemblyName>
    <RootNamespace>BasicMethod.Declarative.Tools.LedgerForge</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 离线工具**自有输出目录**：不进 CsharpPrj 权威烘焙目录 —— 否则其 dll 会被 CentralTest 通配清单
         （$(CsharpBuildOutputDir)*.dll）注入全体测试工程，且离线依赖（DataCenter.Standards）会灌进烘焙面。
         纪律：离线工具只在离线流程 / CI / 守卫内运行，不被运行时面引用。 -->
    <OutputPath>$(MSBuildProjectDirectory)\BuildOutput\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>声明式台账离线工具（LedgerForge）</ModuleRule_Title>
    <ModuleRule_Layer>1</ModuleRule_Layer>
    <ModuleRule_Description>通用声明式台账的**离线写入器**（非运行时面）：读台账数据视图执行 ① 只读对拍（check / check --bytes）② 分片重组与切分（compose / split，缺省 dry-run + 字节对拍门）③ impl 区间改写（set-impl，花括号配平 / 其余字节逐字保留 / 幂等）④ 步骤 kind → 端口键归一（normalize-key，冻结 legacyMap 为唯一映射源 / --check 残留即红）⑤ 词表 → 结构门 CLI 入口（derive-schema，算法唯一实现在标准层）⑥ 声明化骨架草稿与缺失落点清单（emit-declaration，哨兵 __BIND__ 须人工审定）⑦ **声明体干跑校验**（lint，不构建即报键位置 / 算子可达 / 槽拼写 / 平铺失效；政策读数据视图 lint 段，口径对齐构建期 ScriptedDeclarationGuardTests，不作放行依据）⑧ **入口形态判据**（entry-check，离线反射判 public static / 无委托 / 非 async / 有返回 / 实参可匹配；`--kind declared` 预检「已声明 target/method 但 kind 未切」的条目；政策读数据视图 entry 段）。纪律：只准离线工具写台账；词表/键/分组规则/文案一律取自外部单源；一切写入缺省 dry-run，先过对拍门再落盘。</ModuleRule_Description>
    <ModuleRule_Keywords>声明式;台账;离线工具;分片;重组;对拍;字节对拍;impl改写;键归一;结构门;骨架草稿;干跑校验;声明体校验;入口形态判据;LedgerForge</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="离线工具工程：只在离线流程 / CI / 守卫内运行，不被运行时面引用（禁进伞聚合与产品解决方案）" />
    <ModuleRule_Rule Include="台账写入只准 *.Tools 离线工程（守卫 LedgerWrites_AreAbsentFromCSharpSources 的改写口径）" />
    <ModuleRule_Rule Include="数据 / 逻辑分离：分组规则 / 路径 / 文案一律读 Split-SpecPortLedger.data.json，工具内零端口键、零领域词" />
    <ModuleRule_Rule Include="写侧先对拍后落盘：compose / split 缺省 dry-run（与磁盘文件逐字节比较，差异即红）；写入前须过字节对拍门，禁止「先写再核对」" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_JsonMethod)" />
    <ProjectReference Include="$(Proj_DeclarativeLedger)" />
    <!-- F2-a ⑤ derive-schema：词表 → 结构门（schema enum / 键集）算法唯一实现在标准层，
         本工具只做 CLI 接线（禁第二份算法）。契约面 + 标准层均为 Frame 内工程（Frame 内源引用合法）。 -->
    <ProjectReference Include="$(CsharpPrjDir)..\DataCenter\DataCenter.Protocol\DataCenter.Protocol.csproj" />
    <ProjectReference Include="$(CsharpPrjDir)..\DataCenter\DataCenter.Standards\DataCenter.Standards.csproj" />
  </ItemGroup>

</Project>
