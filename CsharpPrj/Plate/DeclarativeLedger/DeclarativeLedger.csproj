<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用声明式契约台账机制</ModuleRule_Title>
    <ModuleRule_Layer>1</ModuleRule_Layer>
    <ModuleRule_Description>通用声明式契约台账机制（收敛治理型）—— 键控目录（确定性排序 + 键唯一 + 原文随行）/ 判据接口 ILedgerRule（编号 + 跨项 + 一次报全）/ 判据宿主 LedgerConsistency（阻断不 warn）/ 违规异常 DeclarationViolationException（非 sealed，供消费侧派生保留身份）/ **台账文本口径 PsJsonText（生成式机制：与 PowerShell ConvertTo-Json 逐字节同口径，2 空格缩进 + CRLF + 无尾换行 + 数值原文 + 转义同 Newtonsoft 默认；供离线写入器重组分片与产物）**。零项目引用（仅 BCL）：JSON 读取与结构校验机制归平台 JSON 框架 Plate.JsonMethod，本工程只承载台账治理机制。</ModuleRule_Description>
    <ModuleRule_Keywords>声明式;契约台账;键控目录;判据;一致性;收敛治理;文本口径;字节对拍;零依赖</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="零 ProjectReference 为硬约束：消费方（如只引纯契约的标准层）不得经本工程拖入任何外部依赖链" />
    <ModuleRule_Rule Include="本工程不含 JSON 机制：JSON 读取原语 / 原文层重复键扫描 / schema 子集校验唯一实现于 Plate.JsonMethod（由使用端直接复用）" />
    <ModuleRule_Rule Include="校验失败即阻断（DeclarationViolationException，不 warn）；异常刻意非 sealed，消费方可派生子类保留既有 catch 面" />
    <ModuleRule_Rule Include="台账文本口径唯一实现 = PsJsonText：写侧（离线工具重组分片/产物）禁用自带缩进与转义逻辑，禁 printf 式拼 JSON，否则字节对拍必红" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要确定性排序 + 键唯一 + 原文随行的键控目录时，使用 LedgerCatalog&lt;TEntry&gt;" />
    <ModuleRule_Prompt Include="当需要「编号 + 跨项 + 一次报全」的契约判据时，实现 ILedgerRule&lt;TCatalog&gt; 并经 LedgerConsistency 求值" />
    <ModuleRule_Prompt Include="当需要声明式 JSON 读取 / 结构校验机制时，使用平台框架 Plate.JsonMethod（本工程不再提供）" />
    <ModuleRule_Prompt Include="当需要产出与既有 PowerShell ConvertTo-Json 产物逐字节一致的台账文本（分片/产物重组、区块改写）时，使用 PsJsonText（勿自写缩进/转义）" />
    <ModuleRule_Prompt Include="当需要「具名枚举词表」的单一 C# 源（结构门 enum / 执行分支 / 文案词表段一律派生）时，使用 LedgerTerm + LedgerVocabulary" />
    <ModuleRule_Prompt Include="当需要「分层键闭包 / 未知键 fail-fast」的唯一实现（读取器 / 结构门 / 离线校验共用）时，使用 LedgerKeyClosure" />
    <ModuleRule_Prompt Include="当需要「按位构造的镜像模型」位序对账（防静默错位）时，使用 LedgerMirrorGuard" />
    <ModuleRule_Prompt Include="当需要「声明的词必须有实现 / 实现的词必须已登记」（幽灵词判据）时，使用 LedgerVocabularyCoverage" />
    <ModuleRule_Prompt Include="当需要「词表 → 结构门枚举」的只读对账（集合 + 词序）时，使用 LedgerEnumPlan + LedgerEnumBinding（写回留离线工具）" />
    <ModuleRule_Prompt Include="当需要「通用运行时映射器」的位序映射表（替代逐模型手写按位构造、免 Roslyn）时，使用 LedgerMirrorPlan" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Rules_Extra">
    <ModuleRule_Rule Include="词表 / 键闭包 / 镜像对账均为机制半，不含领域词：词表内容与层名全部由消费方注入，框架只承担登记、闭包判定与位序对账" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>BasicMethod.Declarative.Ledger</RootNamespace>
    <AssemblyName>BasicMethod.Declarative.Ledger</AssemblyName>
    <Description>通用声明式契约台账机制（收敛治理型）—— 键控目录 / 判据接口 / 判据宿主 / 违规异常；零项目引用（仅 BCL）</Description>
  </PropertyGroup>

  <!-- 零 ProjectReference 为硬约束：消费方（如只引纯契约的标准层）不得经本工程拖入任何外部依赖链。
       JSON 机制（容错读取 / 元素原语 / 重复键扫描 / schema 子集校验）归属 Plate.JsonMethod，由使用端直接复用。 -->

</Project>
