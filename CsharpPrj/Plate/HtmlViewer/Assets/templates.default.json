{
  "htmlShell": "<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><meta name=\"color-scheme\" content=\"{colorScheme}\" /><style>{css|raw}</style></head><body>{body|raw}</body></html>",
  "emptyP": "<p class=\"empty\">{text}</p>",
  "layoutShell": "<div class=\"shell\">{selector|raw}<div class=\"shell-body\"><div class=\"shell-aside\" {pollAttrs|raw}><div class=\"panel-title\">{title|raw}<button type=\"button\" class=\"btn-icon\" data-poll-refresh {pollAttrs|raw} title=\"{refreshTitle}\">⟳</button></div>{tree|raw}</div><div class=\"shell-main\"><div class=\"shell-title\">{subtitle|raw}</div>{?runtime}{runtime|raw}{/}{history|raw}</div></div>{overlay|raw}</div>",
  "groupedPanel": "<details class=\"panel region-fold\" data-name=\"nodes-panel-{task}\" open><summary class=\"panel-head\">{?title}{title}（{task}）{:else}分组（{task}）{/}</summary>{?note}<div class=\"panel-note\">{note}</div>{/}{?hasGroups}{#each groups}{>groupBlock}{/each}{:else}<div class=\"empty\">（暂无分组）</div>{/}</details>",
  "attachItem": "<div class=\"attach-item{?prompt} note-layer{/}\" data-key=\"{key}\">{?badge}<span class=\"attach-badge\">{badge}</span>{:else}<span class=\"attach-head\">{stage}{?showSubagent} · {subagent}{/}</span>{/}<div class=\"attach-text\">{text}</div>{?hasResult}<details class=\"attach-result\" data-key=\"{resultKey}\"><summary class=\"attach-result-toggle\">{resultLabel}</summary><div class=\"attach-text\">{resultText}</div></details>{/}</div>",
  "blockItem": "<div class=\"block{?role=user} user{/}{?role=assistant} assistant{/}{?role=tool} assistant{/}{?role=error} error{/}{?role=system} system{/}{?tool} nested{/}\" data-key=\"{key}\"><span class=\"block-badge\">{round} {role}{?stage}:{stage}{/}</span>{?answerTrace}<span class=\"answer-trace\">{answerTraceLabel}</span>{/}{?anchor}{?prompt}<details class=\"fold-layer note-layer\" data-key=\"{key}-prompt\"><summary class=\"fold-summary\">{stage}{?showSubagent} · {subagent}{/}</summary><div class=\"block-body\">{text}</div></details>{:else}<div class=\"block-body\">{text}</div>{/}{?attachCount}<details class=\"attach\" open data-key=\"{key}-attach\"><summary class=\"attach-toggle\">{attachSummary}</summary>{?attachGroups}{#each attachGroups}{>attachGroup}{/each}{:else}{#each attach}{>attachItem}{/each}{/}</details>{/}{:else}{?prompt}<details class=\"fold-layer note-layer\" data-key=\"{key}-prompt2\"><summary class=\"fold-summary\">{stage}{?showSubagent} · {subagent}{/}</summary><div class=\"block-body\">{text}</div></details>{:else}{?tool}<details class=\"fold-layer\" open data-key=\"{key}-tool\"><summary class=\"fold-summary\">{stage}{?showSubagent} · {subagent}{/}</summary><div class=\"block-body\">{text}</div></details>{:else}<div class=\"block-body\">{text}</div>{/}{/}{/}</div>",
  "actionPanel": "<div class='op-panel' style='border:1px solid var(--border);border-radius:8px;margin:6px 0 10px;padding:8px 10px;background:var(--agent-bg);'><div class='op-panel-title' style='font-size:12px;color:var(--muted);letter-spacing:.04em;margin-bottom:6px;'>操作 / 任务</div>{#each rows}<div class='op-row' style='padding:4px 0;border-top:1px dashed var(--border);'><span class='op-badge' style='font-size:12px;color:var(--muted);'>{round} · {title}{?showSubagent} · <span class='op-actor' title='子智能体 / 执行体'>{subagent}</span>{/}{?showTargets} → <span class='op-targets' title='分发目标集'>{targets}</span>{/}</span><div class='op-text' style='white-space:pre-wrap;word-break:break-word;font-size:14px;'>{text}</div></div>{/each}</div>",
  "stateRow": "<div class=\"state-row\"><span class=\"item-title\">{task}</span>{?poolStatus}<span class=\"state-tag {statusClass}\" title=\"任务池状态：{poolStatus}\">{poolStatus}</span>{/}{?active}<span class=\"state-tag\">ACTIVE</span>{/}<span class=\"state-meta\">stage={stage} actor={actor} round={round} elapsed={elapsed} origin={origin}</span>{?note}<span class=\"state-note\">{note}</span>{/}</div>",
  "windowLine": "<div class=\"wl {role}\" data-key=\"w-{key}\"><span class=\"wl-head\">{roleLabel}{?showSubagent} · {subagent}{/}{?stage} · {stage}{/}</span><div class=\"wl-text\">{text}</div></div>",
  "feedRow": "<div class=\"feed-row\" data-key=\"f-{key}\"><span class=\"feed-badge\">{round} · {title}</span>{?showSubagent}<span class=\"feed-subject\"> · {subagent}</span>{/}{?showTargets}<span class=\"feed-targets\">→ {targets}</span>{/}<div class=\"feed-text\">{text}</div></div>",
  "attachGroup": "<div class=\"attach-group\" data-key=\"{key}\" data-group-kind=\"{group}\"><div class=\"attach-group-head\"><span class=\"attach-group-label\">{label}</span><span class=\"attach-group-count\">{count}</span></div>{#each items}{>attachItem}{/each}</div>",
  "detailRow": "<div class=\"row\"><code class=\"row-key\">{key}</code>{?badge}<span class=\"row-status\">{badge}</span>{/}{?ports}<span class=\"tag\">{ports}</span>{/}{?title}<span class=\"row-title\">{title}</span>{/}{?updated}<span class=\"row-updated\">{updated}</span>{/}{?summary}<div class=\"row-summary\">{summary}</div>{/}</div>",
  "statePanel": "<div class=\"state-panel\"><div class=\"panel-head\">挂载运行状态</div>{rows|raw}{empty|raw}</div>",
  "groupBlock": "<details class=\"group\" open data-name=\"node-type-{label}\"><summary class=\"group-head\"><span class=\"group-badge\">{label}</span><span class=\"group-count\">{count}</span></summary><div class=\"group-body\">{#each nodes}{>detailRow}{/each}</div></details>",
  "emptyDiv": "<div class=\"empty\">{text}</div>",
  "splitShell": "<div class=\"panel\">{nodes|raw}</div><div class=\"pane-secondary\">{history|raw}</div>",
  "feedPanel": "<details class=\"feed\" data-key=\"dispatch-feed\"><summary class=\"feed-summary\">{summary}</summary>{#each rows}{>feedRow}{/each}</details>",
  "board": "<div class=\"board\">{#each items}{>boardCard}{/each}</div>",
  "segGroup": "{#each items}{>segItem}{/each}",
  "sectionHeader": "<section class=\"section\" data-round=\"{round}\"><header class=\"section-header\" data-cmd=\"selectHistory\" title=\"点击定位本轮历史\">{roundTitle}{?costLabel}<span class=\"cost-badge round-cost\">{costLabel}</span>{/}</header>{#each messages}{>blockItem}{/each}</section>",
  "roundFold": "<section class=\"section\" data-round=\"{round}\"><details class=\"round-fold\" data-name=\"round-{round}\" data-round=\"{round}\"{?open} open{/}><summary class=\"section-header round-summary\" data-cmd=\"selectHistory\" title=\"点击定位本轮历史\">{roundTitle}{?costLabel}<span class=\"cost-badge round-cost\">{costLabel}</span>{/}</summary>{#each leadFolds}{>leadFold}{/each}{#each messages}{>blockItem}{/each}</details></section>",
  "leadFold": "<details class=\"lead-fold\" data-name=\"lead-{round}\"><summary class=\"fold-summary\">{leadSummary}</summary>{#each lead}{>blockItem}{/each}</details>",
  "renderDegraded": "<p class=\"render-degraded\" data-reason=\"{reason}\">{text}</p>",
  "dayBadge": "<span class=\"cost-badge day\" title=\"{title}\">{text}</span>",
  "costBadge": "<span class=\"cost-badge\" title=\"{title}\">{text}</span>",
  "costGroup": "<h4 class=\"cost-head\">{title}</h4>{?hasRows}<table class=\"cost-table\"><thead><tr><th>{keyHeader}</th><th class=\"num\">{amountHeader}</th><th class=\"num\">{spanHeader}</th><th class=\"num\">{unknownHeader}</th></tr></thead><tbody>{#each rows}{>costRow}{/each}</tbody></table>{:else}<div class=\"empty\">{empty}</div>{/}",
  "costRow": "<tr><td>{key}</td><td class=\"num\">{amount}</td><td class=\"num\">{span}</td><td class=\"num\">{unknown}</td></tr>",
  "costView": "<div class=\"cost-view\">{body|raw}</div>",
  "costUnpriced": "<h4 class=\"cost-head\">{title}</h4><div class=\"cost-coverage\">{coverage}</div>{?hasRows}<ul class=\"cost-list\">{#each rows}<li>{name}</li>{/each}</ul>{:else}<div class=\"empty\">{empty}</div>{/}",
  "costSummary": "<h4 class=\"cost-head\">{title}</h4><div class=\"cost-summary\">{chips|raw}</div>"
}