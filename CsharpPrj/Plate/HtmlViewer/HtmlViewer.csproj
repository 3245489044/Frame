<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Plate.HtmlViewer</RootNamespace>
    <AssemblyName>Plate.HtmlViewer</AssemblyName>
    <Description>WinForms 内嵌 HTML 查看器（可信富文本通道）：WebView2 直接渲染 body 片段 + 文档壳；纯渲染基础设施（零上层依赖）。Observe 收敛写与 Conversation 会话渲染的跨层胶水已迁出至 FrontEndDriven/HtmlViewerBridge（DIP）。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2478.35" />
  </ItemGroup>

  <!-- ★ 2026-08-24 HTML 后端逻辑（Abstractions/ + Html/）已并入本项目：声明模型仍依赖 TConfig -->
  <ItemGroup>
    <ProjectReference Include="..\..\Plate\TConfig\TConfig.csproj" />
    <!-- ★ 2026-08-25 通用 JSON 占位替换内核 + 脚本命令反序列化统一经 Plate.JsonMethod（TemplateFormatter / JsonSerializerFactory） -->
    <ProjectReference Include="..\JsonMethod\JsonMethod.csproj" />
    <!-- ★ 2026-09 依赖倒置（DIP）：Observe.csproj / Share.Conversation.csproj 两个上游引用已移除——
         收敛写（ObservedHtmlChannel/WebView2Transport）与会话渲染（HtmlStreamRenderer）迁移至 FrontEndDriven/HtmlViewerBridge，
         plate 回归「纯渲染基础设施」定位。 -->
  </ItemGroup>

</Project>
