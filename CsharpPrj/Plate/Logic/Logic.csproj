<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用三值逻辑与高阶算子库</ModuleRule_Title>
    <ModuleRule_Layer>1</ModuleRule_Layer>
    <ModuleRule_Description>平台级纯函数逻辑算子库（clinerules logic §1 物化）：三值真值域 TruthValue/ThreeValuedLogic（T/F/⊥, Scott 吸收律）、Aggregate（Key/Causal/Window/Weight）、Assess（Conjunction/Projection/TruthMap）、Resolve（Table/Chain/Fsm/StateAssign）。全部为静态纯函数，LLM-free、零依赖。</ModuleRule_Description>
    <ModuleRule_Keywords>三值逻辑;TruthValue;Aggregate;Assess;Resolve;纯函数;clinerules</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="此模块是平台层纯函数逻辑算子库，供上层模块（Share/Operation）复用，聚合项目经 ProjectReference 消费" />
    <ModuleRule_Rule Include="仅含静态纯函数，无状态、无 I/O、零第三方依赖，可在零 AI 额度纯 CI 测试" />
    <ModuleRule_Rule Include="命名空间统一使用 Plate.Logic.*" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要三值真值判定（T/F/⊥ 合取/析取/否定）时，使用 TruthValue/ThreeValuedLogic" />
    <ModuleRule_Prompt Include="当需要决策路由/状态转移/字段重赋值时，使用 Resolve" />
    <ModuleRule_Prompt Include="当需要聚合/递推/EWMA时，使用 Aggregate" />
    <ModuleRule_Prompt Include="当需要对子结论做合取/投影判定时，使用 Assess" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Plate.Logic</RootNamespace>
    <AssemblyName>Plate.Logic</AssemblyName>
    <AssemblyTitle>Plate Logic Operators</AssemblyTitle>
    <Description>平台级通用三值逻辑与高阶算子库（TruthValue/Assess/Aggregate/Resolve）</Description>
  </PropertyGroup>

</Project>