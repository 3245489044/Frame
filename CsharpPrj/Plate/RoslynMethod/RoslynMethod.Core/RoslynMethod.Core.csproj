<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0：源生成器/分析器侧（RoslynJson）硬约束要求；net10.0-windows 消费方（RoslynMethod/Plate/Registry）可正常引用 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RoslynMethod.Core</AssemblyName>
    <RootNamespace>RoslynSpace</RootNamespace>
    <Description>Roslyn 编译核心工具集 — 提供 CompilationReferenceHelper、UsingManager、CompilationSkeleton 等轻量级 Roslyn 工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn：PrivateAssets=all 不透传到下游（本工程被 RoslynJson 引用，分析器运行期闭包不得携带 Roslyn）；
         各消费方（RoslynMethod/Registry/RoslynJson）自行声明所需版本 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
