<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 单目标：被 RoslynJson（现 net10.0-windows）与 RoslynMethod/Plate/Registry（net10.0-windows）共同引用（TFM 高吃低）；
         保持 netstandard2.0 亦使任意宿主可加载本内核。 -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RoslynMethod.Core</AssemblyName>
    <RootNamespace>RoslynSpace</RootNamespace>
    <Description>Roslyn 编译核心工具集 — 提供 CompilationReferenceHelper、UsingManager、CompilationSkeleton 等轻量级 Roslyn 工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn：PrivateAssets=all 不透传到下游（下游运行期闭包不得携带 Roslyn）；
         各消费方（RoslynMethod/Registry/RoslynJson）自行声明所需版本 -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
