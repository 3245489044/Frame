<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_Mathematics)" />
    <!-- 共享内核独立工程（netstandard2.0），供本工程与 RoslynJson 分析器侧共用同一实现 -->
    <!-- 共享内核独立工程（netstandard2.0），供本工程与 RoslynJson 分析器侧共用同一实现 -->
    <ProjectReference Include="$(Proj_RoslynMethod_Core)" />
    <!-- 转换内核（IR + JSON 文本发射器，netstandard2.0 零依赖）：JSON 结构一律经内核发射，避免第二份 JSON 文本实现 -->
    <ProjectReference Include="$(Proj_LogicComposition_Conversion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DeepCloner" Version="$(DeepClonerVersion)" />
    <PackageReference Include="DynamicExpresso.Core" Version="$(DynamicExpressoCoreVersion)" />
    <PackageReference Include="MathNet.Numerics" Version="$(MathNetNumericsVersion)" />
    <PackageReference Include="Microsoft.Agents.Core" Version="$(MicrosoftAgentsCoreVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsLoggingVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="$(SystemLinqDynamicCoreVersion)" />
    <PackageReference Include="System.Reactive" Version="$(SystemReactiveVersion)" />
  </ItemGroup>

  <!-- 排除非本项目的目录（测试项目、其他独立项目） -->
  <ItemGroup>
    <Compile Remove="TestMent\**\*.cs" />
    <None Include="TestMent\**\*.cs" />
    <Compile Remove="CodePathExplorer\**\*.cs" />
    <None Include="CodePathExplorer\**\*.cs" />
    <Compile Remove="CodePathExplorer.Tests\**\*.cs" />
    <None Include="CodePathExplorer.Tests\**\*.cs" />
    <Compile Remove="CodeRLFramework\**\*.cs" />
    <None Include="CodeRLFramework\**\*.cs" />
    <Compile Remove="Agent\**\*.cs" />
    <None Include="Agent\**\*.cs" />
    <Compile Remove="Agent.Tests\**\*.cs" />
    <None Include="Agent.Tests\**\*.cs" />
    <Compile Remove="Mathematics\**\*.cs" />
    <None Include="Mathematics\**\*.cs" />
    <!-- ★ 独立子项目（低层共享内核）：经 ProjectReference 引用，须排除其源码避免类型在 RoslynMethod.dll 重复编译（CS0433） -->
    <Compile Remove="RoslynMethod.Core\**\*.cs" />
  </ItemGroup>

</Project>
