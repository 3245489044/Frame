<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>命令框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用命令执行框架：命令字符串解析、注册、管线执行到结果返回的完整生命周期，含抽象/执行/调用/模型/参数/校验等子域。</ModuleRule_Description>
    <ModuleRule_Keywords>命令,解析,注册,执行,管线,校验,通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>CommandFramework</AssemblyTitle>
    <AssemblyDescription>通用命令执行框架 — 提供命令解析、注册、执行、撤销/重做、工作流编排功能</AssemblyDescription>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>CommandFramework</RootNamespace>
    <AssemblyName>CommandFramework</AssemblyName>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 原有 CommandFramework 依赖 -->
    <ProjectReference Include="$(Proj_ParameterResolver)" />
    <ProjectReference Include="$(Proj_Pipeline)" />
    <ProjectReference Include="$(Proj_Registry)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
    <ProjectReference Include="$(Proj_Parsing)" />

    <!-- TConfig 统一控件值读写接口 -->
    <ProjectReference Include="$(Proj_TConfig)" />

    <!-- WorkflowExecution 合并过来的依赖 -->
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <ProjectReference Include="$(Proj_StateManagement)" />
    <ProjectReference Include="$(Proj_ExecutionFramework)" />
    <ProjectReference Include="$(Proj_GraphFramework)" />

    <!-- ★ 2026-09-06：路径单一真源收敛 —— 命令配置解析经 Route.InformationPaths（锚定 Projects\Information\DrivenConfig），
         替代 CommandSystemBase.ResolveConfigPath 旧硬编码 projectRoot\FileDriven\DrivenConfig（该目录已迁移迁空）。
         决策 A（2026-09-05-路径收敛设计 §四）：Route 为自包含零依赖共享核心，FileDriven 薄启动层白名单保留其 dll。 -->
    <ProjectReference Include="$(CsharpPrjDir)..\..\Projects\Route\Route.csproj" />


    <!-- ★ 2026-07-05 新增：Container 通用执行容器框架引用
         用于 ExecuteCommandStage 通过 IExecutionCell 执行事件命令，
         获得 Container 弹性策略链（重试、熔断、超时、日志） -->
    <ProjectReference Include="$(BasicMethodRoot)Container\Container.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="$(MicrosoftExtensionsLoggingAbstractionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftExtensionsDependencyInjectionAbstractionsVersion)" />
    <PackageReference Include="Polly" Version="$(PollyVersion)" />
    <PackageReference Include="Polly.Core" Version="$(PollyCoreVersion)" />
    <PackageReference Include="FluentValidation" Version="$(FluentValidationVersion)" />
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
  </ItemGroup>

  <!-- ★ 2026-07-23 新增：排除 _deprecated 目录，避免已废弃的接口定义造成歧义引用 -->
  <ItemGroup>
    <Compile Remove="_deprecated\**\*" />
    <None Include="_deprecated\**\*" />
  </ItemGroup>

</Project>


