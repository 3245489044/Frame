<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>占位符框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用数据引用追踪框架（占位符）：把数据引用解析与追踪统一为可组合管线，配合工作流框架完成占位符求值。</ModuleRule_Description>
    <ModuleRule_Keywords>占位符,数据引用,追踪,解析,管线,通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Common.PlaceholderFramework</RootNamespace>
    <AssemblyName>PlaceholderFramework</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- BasicMethod.Pipeline 命名空间已迁移到 Share.Pipeline -->
    <ProjectReference Include="$(Proj_Pipeline)" />
    <ProjectReference Include="$(Proj_UniversalWorkflowFramework)" />
    <ProjectReference Include="$(Proj_Diagnostics)" />
    <ProjectReference Include="$(Proj_Parsing)" />
    <ProjectReference Include="$(Proj_GraphFramework)" />
    <ProjectReference Include="$(Proj_MetaCommand)" />
    <!-- 引入 BasicMethod.ReflectionMethod 框架，用于反射获取调用方信息 -->
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <!-- 引入 Plate.JsonMethod 平台级统一 JSON 处理框架 -->
    <ProjectReference Include="$(Proj_JsonMethod)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="$(JsonSchemaNetVersion)" />
    <PackageReference Include="JsonPath.Net" Version="$(JsonPathNetVersion)" />
  </ItemGroup>

  <!-- 排除废弃的源文件，不被项目编译 -->
  <ItemGroup>
    <Compile Remove="_deprecated\**\*.cs" />
    <None Include="_deprecated\**\*" />
  </ItemGroup>

</Project>
