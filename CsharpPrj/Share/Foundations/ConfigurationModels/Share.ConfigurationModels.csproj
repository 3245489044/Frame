<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>配置模型</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>共享配置模型库——纯 POCO，无任何 UI 框架依赖。</ModuleRule_Description>
    <ModuleRule_Keywords>配置,模型,POCO,共享,无依赖</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- RootNamespace 保持 BasicMethod 以兼容现有 using BasicMethod.ConfigurationModels 的引用 -->
    <RootNamespace>BasicMethod</RootNamespace>
    <AssemblyName>Share.ConfigurationModels</AssemblyName>
    <AssemblyTitle>Share Configuration Models</AssemblyTitle>
    <Description>共享配置模型库 - 纯 POCO，无任何 UI 框架依赖</Description>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅依赖 UniversalLayoutMath（纯数学库，不依赖 BasicMethod） -->
    <ProjectReference Include="$(Proj_UniversalLayoutMath)" />
    <!-- ★ 2026-07-04 新增：引用 CSG.Unified 以使用 ParameterBinding 参数契约类型 -->
    <ProjectReference Include="$(Proj_CSG_Unified)" />
    <!-- ★ 2026-07-15 新增：引用 TConfig 以使用 WorkflowDefinitionEntry 类型 -->
    <ProjectReference Include="$(Proj_TConfig)" />
  </ItemGroup>
  <ItemGroup>
    <!-- P1：初始化护栏门面 + 全局 using（零 using 行改动） -->
    <ProjectReference Include="$(Proj_BasicMethod_Initialization)" />
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
