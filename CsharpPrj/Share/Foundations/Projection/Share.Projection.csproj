<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用投影内核</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>源 → Plan → Step* → Carrier 的纯投影契约与唯一入口（零领域词、零 UI 依赖）。</ModuleRule_Description>
    <ModuleRule_Keywords>投影,计划,载体,内核</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.Projection</RootNamespace>
    <AssemblyName>Share.Projection</AssemblyName>
    <Description>通用投影内核 — Context/Plan/Step/Carrier/Host/Result（零 ProjectReference）</Description>
  </PropertyGroup>

  <!-- 纪律：零 ProjectReference（仅 BCL）；出现 Conversation/Html/WinForms/Node/Agent 即越界。 -->

</Project>
