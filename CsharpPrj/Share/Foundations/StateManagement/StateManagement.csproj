<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>状态管理</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>状态管理框架：状态块（Block）与状态快照/恢复、线程安全的通用状态承载与变更设施。</ModuleRule_Description>
    <ModuleRule_Keywords>状态,状态块,快照,恢复,线程安全,管理</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.StateManagement</RootNamespace>
    <AssemblyName>Share.StateManagement</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- StateMachine 已整合到 BasicMethod.csproj -->
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <!-- 2026-09 StateBus 治理 P3：Modules.Threading（叶子）为派发原语家，供 IPublishDispatcher 桥接（PublishDispatcherAdapter） -->
    <ProjectReference Include="$(Proj_Threading)" />
    <ProjectReference Include="$(BasicMethodRoot)Block\Block.csproj" />
    <ProjectReference Include="$(Proj_Pipeline)" />
    <!-- DiagnosticContext 诊断上下文 -->
    <ProjectReference Include="$(Proj_DiagnosticContext)" />
    <!-- 2026-08-05 StateCenter 契约：IStateCenter.Cell 使用 IStorageCell（TConfig.ContextFrame.Abstractions），
         TConfig 属 Plate 层（Layer 2），不违反 R1（契约仍在 Share）与 R2（无 Operation/UI 引用） -->
    <ProjectReference Include="$(Proj_TConfig)" />
  </ItemGroup>


</Project>
