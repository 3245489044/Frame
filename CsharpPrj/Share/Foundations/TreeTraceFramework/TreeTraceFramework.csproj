<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>树追踪框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用树形追踪框架——从 CallFrame 提取的通用树追踪、查询与序列化能力。</ModuleRule_Description>
    <ModuleRule_Keywords>树,追踪,查询,序列化,CallFrame,通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Share.TreeTraceFramework</RootNamespace>
    <AssemblyName>TreeTraceFramework</AssemblyName>
    <AssemblyTitle>通用树追踪框架</AssemblyTitle>
    <Description>通用树形追踪框架 - 从 CallFrame 提取的通用树追踪、查询、序列化能力</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1：全局 using（零 using 行改动） -->
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
