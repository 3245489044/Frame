<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FrameworkAbstractions</AssemblyName>
    <RootNamespace>FrameworkAbstractions</RootNamespace>
    <!-- 启用默认编译项，自动包含所有 .cs 文件 -->
    
  </PropertyGroup>

  <ItemGroup>
    <!-- Framework.Abstractions 和 Framework 已整合到 BasicMethod.csproj -->
    <ProjectReference Include="..\..\BasicMethod\BasicMethod.csproj" />
    <!-- TConfig 统一控件值读写接口 -->
    <ProjectReference Include="..\..\Plate\TConfig\TConfig.csproj" />
    <!-- DiagnosticContext 诊断上下文 -->
    <ProjectReference Include="..\..\Modules\DiagnosticContext\DiagnosticContext.csproj" />
  </ItemGroup>

</Project>
