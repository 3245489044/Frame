<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用工具多轮循环内核（Share.AgentLoop）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用 LLM 工具多轮循环内核：契约 DTO + 单次/多轮工具循环；工具执行经委托注入，不绑定任何 Agent 执行器。</ModuleRule_Description>
    <ModuleRule_Keywords>LLM;工具循环;多轮;契约;通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>Share.AgentLoop</RootNamespace>
    <AssemblyName>Share.AgentLoop</AssemblyName>
    <Description>通用工具多轮循环内核（零 Agent 依赖）</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_Share_ContextGeometry)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
  </ItemGroup>

</Project>
