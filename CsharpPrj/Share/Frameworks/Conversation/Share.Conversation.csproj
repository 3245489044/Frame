<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>对话日志</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>对话历史纯逻辑模型（消息列表 + 追加 + 窗口渲染 + 序列化）。零 Agent 依赖；为「Task 即对话」的会话快照归档（Data.__conversation）提供读写收敛工具。</ModuleRule_Description>
    <ModuleRule_Keywords>对话,消息,日志,序列化,会话</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.Conversation</RootNamespace>
    <AssemblyName>Share.Conversation</AssemblyName>
    <Description>对话日志 — 消息模型 + 追加 + 窗口渲染 + 序列化（含 Stage/SubAgent 泛化）</Description>
  </PropertyGroup>

</Project>
