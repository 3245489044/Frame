<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>对话日志</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>对话历史纯逻辑模型（消息列表 + 追加 + 窗口渲染 + 序列化）。零 Agent 依赖；为「Task 即对话」的会话快照归档（Data.__conversation）提供读写收敛工具。</ModuleRule_Description>
    <ModuleRule_Keywords>对话,消息,日志,序列化,会话</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.Conversation</RootNamespace>
    <AssemblyName>Share.Conversation</AssemblyName>
    <Description>对话日志 — 消息模型 + 追加 + 窗口渲染 + 序列化（含 Stage/SubAgent 泛化）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 会话事实标准机制层（Facts/：标识 + append-only 事实文档 + 线格式 + 存储端口）：
         本程序集为平台层（零 Agent 依赖），线格式 schema 作跨语言契约随程序集嵌入分发。
         真源 = Projects\Plug\Agent\Config\session-facts.ushar（声明面），生成物 = Facts\Schema\session-fact.v1.schema.json。 -->
    <EmbeddedResource Include="Facts\Schema\session-fact.v1.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通用投影内核（Plan/Step/Carrier/Host/Result；零 ProjectReference）。 -->
    <ProjectReference Include="$(Proj_Share_Projection)" />
    <!-- 通用能力内核（层 × 能力三态/值域 × fallback）：表面解析的层裁剪与降级委托此内核（单实现）。 -->
    <ProjectReference Include="$(Proj_CapabilityResolution)" />
    <!-- 聚拢契约（IGatherModule / GatherModuleBuilder）：2026-11-08 随 Share.SurfaceModel 并入（表面聚拢模块）。 -->
    <ProjectReference Include="$(Proj_Gather)" />
    <!-- 表面色值契约（UiBackend.SurfaceColor / SurfaceColorDomain）：值域分类与不透明合成的单点。 -->
    <ProjectReference Include="$(Proj_Plate_Surface)" />
    <!-- 表面着色数学（MathematicalAlgorithms.Lighting.SurfaceShadingMath）：Sheen/暖度公式单源。 -->
    <ProjectReference Include="$(Proj_Mathematics)" />
    <!-- 锚点族单源（R5）：history 锚点族 + 节点端点文法一律取层 2 键框架，禁本地第二套切分/正则。 -->
    <ProjectReference Include="$(Proj_Parsing_Keys)" />
    <ProjectReference Include="$(Proj_KeySpace)" />
    <ProjectReference Include="$(Proj_Node)" />
    <!-- 文本段组合内核（Modules\Data\NodeText，BCL-only）：声明的块/模板/计划/摘要单源（CV-03）。 -->
    <ProjectReference Include="$(Proj_Modules_Data_NodeText)" />
  </ItemGroup>

</Project>
