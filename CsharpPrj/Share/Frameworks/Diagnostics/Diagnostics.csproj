<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>诊断</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>共享诊断设施（Common.Diagnostics）：日志、指标与诊断上下文的通用实现，供 Share 各模块及上层引用。</ModuleRule_Description>
    <ModuleRule_Keywords>诊断,日志,指标,诊断上下文,通用</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- ★ 已移除 UseWindowsForms 依赖，FrameworkErrors 不再使用 MessageBox -->
    <RootNamespace>Common.Diagnostics</RootNamespace>
    <AssemblyName>Share.Diagnostics</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <!-- Logging 已整合到 BasicMethod.csproj -->

    <ProjectReference Include="$(Proj_Pipeline)" />

    <ProjectReference Include="$(Proj_DiagnosticContext)" />

    <ProjectReference Include="$(Proj_UniversalWorkflowFramework)" />

  </ItemGroup>

  <!-- ★ 确保 config/ 目录下的配置文件复制到输出目录，供运行时加载 -->
  <ItemGroup>
    <None Update="config\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- P1：全局 using（零 using 行改动，见 初始化与错误处理通用框架-应用分析.md §A） -->
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
