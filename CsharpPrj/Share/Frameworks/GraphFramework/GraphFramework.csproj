<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>图框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用图框架：图模型与快照、ECS 图、分析、指令、执行与桥接，提供图构建与遍历的通用能力。</ModuleRule_Description>
    <ModuleRule_Keywords>图,模型,快照,ECS,分析,指令,执行</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GraphFramework</RootNamespace>
    <AssemblyName>GraphFramework</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- GraphFoundation 已整合到 BasicMethod.csproj -->
    <ProjectReference Include="$(Proj_BasicMethod)" />

    <!-- 引用 Dispose.GraphProcessing 以复用实现层（归一化、编排、引用处理等） -->
    <ProjectReference Include="$(Proj_GraphProcessing)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
    <!-- 引用 Modules.Pipeline 以复用通用管线框架（IPipeline、PipelineBase、PipelineContext 等） -->
    <ProjectReference Include="$(Proj_Pipeline)" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1：全局 using（零 using 行改动，见 初始化与错误处理通用框架-应用分析.md §A） -->
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
