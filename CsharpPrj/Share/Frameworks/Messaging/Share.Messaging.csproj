<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用信息传递内核</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>领域无关的消息信封/地址/生命周期/路由策略/流控判据/闭包报告；零 IO、零 Agent 依赖、零 ProjectReference（仅 BCL），供 Share 及以上层与产品侧共同消费。</ModuleRule_Description>
    <ModuleRule_Keywords>消息;信封;生命周期;路由;TTL;幂等;闭包</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="内核零 ProjectReference：不得引用 Agent.* / Operation.* / Share.*，禁存储/网络/时钟依赖（时间一律由参数传入）；唯一例外为 BCL-only 的 Modules.* 内核模块（仅程序集迁移、命名空间保持 Share.*，见下方 ProjectReference 注释）" />
    <ModuleRule_Rule Include="唯一状态机 MessageState：适配器只做映射，不新增第三套状态枚举" />
    <ModuleRule_Rule Include="唯一键面：内核只给逻辑 MessageId 与 StableToken，物理键（xfer:/sig:/会话键）留在适配器" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.Messaging</RootNamespace>
    <AssemblyName>Share.Messaging</AssemblyName>
    <Description>通用信息传递内核 — 信封 + 地址 + 状态机 + 路由策略 + 流控 + 闭包（纯逻辑）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 生命周期迁移表本体（Modules\Frameworks\Messaging，BCL-only）：命名空间保持 Share.Messaging，
         迁移只换程序集、不改任何消费端类型全名（MS-01）。 -->
    <ProjectReference Include="$(Proj_Modules_Frameworks_Messaging)" />
  </ItemGroup>

</Project>
