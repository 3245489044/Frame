<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用刷新框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用刷新管理框架（零领域 / 零 HTML / 零 Plate）：L0 契约（范围键 RefreshScope / 单调版本凭证 RefreshTicket / 交付信封 RefreshDelivery / 指纹单源 IFingerprint / 单一状态源 IRefreshStore / 写落地端口 IRefreshSink / 追踪号 RefreshTraceId）+ L2 写仲裁引擎（RefreshArbiter：每 slot 单调版本 + baseline 过期即丢 + 在飞 latest-wins 合并 + 未变 Skip）。刷新语义唯一 owner，写落地由宿主经 IRefreshSink 反向注入实现。</ModuleRule_Description>
    <ModuleRule_Keywords>刷新,修订,去重,指纹,单一状态源,在飞合并,写仲裁,通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.RefreshFramework</RootNamespace>
    <AssemblyName>Share.RefreshFramework</AssemblyName>
    <AssemblyTitle>通用刷新框架</AssemblyTitle>
    <Description>通用刷新管理框架 - 版本/指纹/在飞合并的刷新语义单一 owner</Description>
  </PropertyGroup>

</Project>
