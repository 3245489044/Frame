<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>表面模型（SurfaceModel）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>跨产品表面门面与聚拢模块（产品无关）：包装已声明的容器/映射/外观程序，向外提供能力矩阵、选择快照、解析计划与降级清单六域；不持有静态单例，不读 Agents 配置。</ModuleRule_Description>
    <ModuleRule_Keywords>表面;门面;聚拢;选择;能力;降级;投影</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="产品无关：零 Agent/Operation/Strategy 依赖；配置/选择由装配期注入" />
    <ModuleRule_Rule Include="零载体字面量（无 div/span/html/css/控件名）；载体 id 只作数据值" />
    <ModuleRule_Rule Include="producer 不读静态单例：所有输入经构造注入（程序/选择源/载体）" />
    <ModuleRule_Rule Include="缺失与降级必须显式产出（surface-degradations），禁静默空计划" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.SurfaceModel</RootNamespace>
    <AssemblyName>Share.SurfaceModel</AssemblyName>
    <Description>跨产品表面门面 + 六域聚拢模块（产品无关）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 既有解析层（M2）：本批以门面方式复用，解析器不搬家 -->
    <ProjectReference Include="$(Proj_Share_Conversation)" />
    <!-- 通用能力三态 / 层降级内核 -->
    <ProjectReference Include="$(Proj_CapabilityResolution)" />
    <!-- 聚拢契约（IGatherModule / GatherModuleBuilder） -->
    <ProjectReference Include="$(Proj_Gather)" />
  </ItemGroup>

</Project>
