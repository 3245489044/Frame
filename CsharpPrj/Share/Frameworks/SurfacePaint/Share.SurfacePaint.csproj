<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>表面绘制框架（SurfacePaint）</ModuleRule_Title>
    <ModuleRule_Layer>2</ModuleRule_Layer>
    <ModuleRule_Description>载体无关的表面运行时：光栅原语（Raster）/几何/边框/缓存键/颜色桥/逐层落笔引擎/页面场与卡片装饰（Ambient）/宿主会话（Hosting）/引擎帧泵（Engine）/材质目录（Materials）/诊断（Diagnostics）。只吃 Graphics/Bitmap 与已解析材质，零控件类型。</ModuleRule_Description>
    <ModuleRule_Keywords>表面;绘制;光栅;几何;边框;缓存键;装饰;页面场;会话;落笔</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="只依赖 SurfacePaint.Contracts/Share.Conversation/Plate.Surface/Plate.Mathematics (Raster 已并入 Raster/) 与 BCL；禁依赖 Operation/Presentation/Strategy" />
    <ModuleRule_Rule Include="只吃 Graphics/Bitmap/Image/Rectangle(F)/已解析材质/令牌；禁 Control/Form/Timer/消息循环" />
    <ModuleRule_Rule Include="宿主能力（视口/背后快照/运行时光/引擎/日志）一律经 Hosting 端口注入；禁读前端静态单例" />
    <ModuleRule_Rule Include="像素算法逐位稳定：同参数输出必须与迁移前实现完全一致" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.SurfacePaint</RootNamespace>
    <AssemblyName>Share.SurfacePaint</AssemblyName>
    <Description>表面绘制内核（载体无关，System.Drawing）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2026-11-09 B1a：契约层（端口就绪态/原因码/视口/皮肤）先行抽出，零依赖；
         本工程只实现，不再拥有这些契约。 -->
    <ProjectReference Include="$(Proj_SurfacePaint_Contracts)" />
    <ProjectReference Include="$(Proj_Plate_Surface)" />
    <ProjectReference Include="$(Proj_Mathematics)" />
    <ProjectReference Include="$(Proj_Share_Conversation)" />
    <!-- 2026-11-08 合并：原 Share.SurfaceRaster 工程已并入本工程 Raster/ 子目录（命名空间 Share.SurfacePaint.Raster），
         减少表面专用工程数量；光栅原语仍是载体无关纯函数。 -->

  </ItemGroup>

</Project>
