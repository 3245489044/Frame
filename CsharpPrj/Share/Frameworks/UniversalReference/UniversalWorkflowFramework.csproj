<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用工作流与引用框架</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>领域无关的工作流与引用框架：动作映射、批次集成、分支管理、事件驱动、关系与存储、工作流执行；供共享层与上层复用。</ModuleRule_Description>
    <ModuleRule_Keywords>工作流;引用;动作映射;分支;事件驱动;关系;存储;执行</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
      <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- ★ UniversalReferenceLayer.cs 现在由本项目编译（Share.csproj 已删除） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="$(MicrosoftExtensionsConfigurationVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="$(MicrosoftExtensionsConfigurationFileExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsConfigurationJsonVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsLoggingVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="$(MicrosoftExtensionsLoggingConsoleVersion)" />
    <PackageReference Include="System.Reactive" Version="$(SystemReactiveVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <!-- ★ 基于 Modules.Pipeline 重构：管线编排统一收敛到 Share.Pipeline（Frame/Pipeline.cs 死代码已移除） -->
    <ProjectReference Include="$(Proj_Pipeline)" />
    <!-- ★ 日志插桩收敛到 Modules.DiagnosticContext 框架：Share 层只做字符串插桩，不负责日志输出 -->
    <ProjectReference Include="$(Proj_DiagnosticContext)" />
    <!-- ★ 平台级统一 JSON 框架：Share 层 JSON 逻辑收敛到 Plate.JsonMethod（经 BasicMethod 传递可用，此处显式声明以便依赖可视化） -->
    <ProjectReference Include="$(Proj_JsonMethod)" />
    <!-- ★ 图处理通用能力：GraphProcessing 下沉通用图算法/去重/归一化/快照（UR → GraphProcessing → BasicMethod，禁止反向） -->
    <ProjectReference Include="$(Proj_GraphProcessing)" />
    <!-- ★ 严格枚举名解析（StrictParse）：读写两端共用「只认名称」口径，禁 Enum.TryParse 数值旁路 -->
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
    <!-- PathManager 和 Logging 已整合到 BasicMethod.csproj -->

  </ItemGroup>

</Project>