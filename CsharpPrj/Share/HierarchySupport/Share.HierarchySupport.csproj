<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>层次方法支撑 DTO（HierarchySupport）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>HierarchyMethod 框架自包含所需的纯数据 DTO 与注册表（LLM-free）：调度模式（SchedulingMode/StrategyDescriptor）、类型化数据空间（DataSpace/IDataSpace/DataScope/PortSpec）与数据契约注册表（DataContract 簇）、运行时快照投影（AgentRuntimeSnapshot/ExecutorRunStatus/RuntimeStage）。零 Agent 依赖；Agent.Contract 经全局类型别名桥接保持引用兼容。</ModuleRule_Description>
    <ModuleRule_Keywords>HierarchySupport;DTO;SchedulingMode;DataSpace;DataContract;RuntimeSnapshot;LLM-free</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Share.HierarchySupport</RootNamespace>
    <AssemblyName>Share.HierarchySupport</AssemblyName>
    <Description>HierarchyMethod 支撑纯 DTO（调度/数据空间/运行时快照，LLM-free）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- RuntimeStage 依赖 TaskExecutionStatus（Share.TaskStatusPool.TaskPool） -->
    <ProjectReference Include="..\TaskStatusPool\TaskStatusPool.csproj" />
  </ItemGroup>

</Project>
