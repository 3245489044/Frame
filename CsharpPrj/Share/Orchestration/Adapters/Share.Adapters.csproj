<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>适配器</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>共享适配器：命名管道客户端与连接管理（NamedPipeClient/Manager）及日志查询适配器（LogQueryAdapter），把外部进程通信与日志检索接入命令框架。</ModuleRule_Description>
    <ModuleRule_Keywords>适配器,命名管道,IPC,日志查询,客户端,命令框架</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MetaCommand</RootNamespace>
    <AssemblyName>Share.Adapters</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_MetaCommand)" />
    <ProjectReference Include="$(Proj_Parsing)" />
    <ProjectReference Include="$(Proj_ExecutionFramework)" />
    <ProjectReference Include="$(Proj_CommandFramework)" />
    <ProjectReference Include="$(Proj_Diagnostics)" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1：初始化护栏门面 + 全局 using（零 using 行改动） -->
    <ProjectReference Include="$(Proj_BasicMethod_Initialization)" />
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
