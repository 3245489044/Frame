<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>事件绑定编排器</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>事件绑定编排器：把声明式事件/命令绑定（Declarative/CSG）编译并编排到通用中间件与命令框架，统一事件管线装配。</ModuleRule_Description>
    <ModuleRule_Keywords>事件绑定,编排,声明式,中间件,命令,装配</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share.EventBindingOrchestrator</RootNamespace>
    <AssemblyName>Share.EventBindingOrchestrator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_BasicMethod)" />
    <ProjectReference Include="$(BasicMethodRoot)Declarative\Declarative.csproj" />
    <ProjectReference Include="$(Proj_Pipeline)" />
    <ProjectReference Include="$(Proj_Parsing)" />
    <ProjectReference Include="$(Proj_Threading)" />
    <ProjectReference Include="$(Proj_PlaceholderFramework)" />
    <ProjectReference Include="$(Proj_ParameterResolver)" />
    <ProjectReference Include="$(Proj_CommandFramework)" />
    <ProjectReference Include="$(Proj_Share_ConfigurationModels)" />
    <ProjectReference Include="$(Proj_UniversalMiddleware)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
    <ProjectReference Include="$(Proj_CSG_Unified)" />
    <ProjectReference Include="$(Proj_DiagnosticContext)" />
    <ProjectReference Include="$(Proj_EventFramework)" />
    <ProjectReference Include="$(Proj_ExecutionFramework)" />
    <ProjectReference Include="$(Proj_TConfig)" />
    <ProjectReference Include="$(Proj_InternalStorage)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="$(FluentValidationVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- P1：全局 using（零 using 行改动） -->
    <Using Include="BasicMethod.Initialization.Guards" />
  </ItemGroup>

</Project>
