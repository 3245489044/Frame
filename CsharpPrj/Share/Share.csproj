<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>共享库</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>共享复用层聚合项目，包含适配器、命令框架（含工作流执行）、诊断、执行中心、图框架、布局分析、参数解析、占位符、状态管理、树追踪、通用中间件、通用引用、事件绑定编排器等子模块</ModuleRule_Description>
    <ModuleRule_Keywords>共享,复用,适配器,命令,工作流,诊断,图框架,中间件,事件绑定,编排器</ModuleRule_Keywords>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Share</RootNamespace>
    <AssemblyName>Share</AssemblyName>
    <Description>Share 聚合项目 - 引用 Share 目录下所有子项目</Description>
    <!-- 聚合项目不含自有源码：关闭默认通配，避免把分组子目录中的 .cs 误编译进 Share.dll（替代原先 19 条 <Compile Remove>） -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(Proj_Share_Adapters)" />
    <ProjectReference Include="$(Proj_CommandFramework)" />
    <ProjectReference Include="$(Proj_Share_Conversation)" />
    <!-- ★ HierarchySupport 叶工程已整项目并入 Strategy\Observability（命名空间 Share.HierarchySupport 保留，源文件随迁）；本聚合不再承载该子项 -->
    <ProjectReference Include="$(Proj_Diagnostics)" />
    <ProjectReference Include="$(Proj_FrameworkAbstractions)" />
    <ProjectReference Include="$(Proj_GraphFramework)" />
    <ProjectReference Include="$(Proj_LayoutAnalysis)" />
    <ProjectReference Include="$(Proj_PlaceholderFramework)" />
    <ProjectReference Include="$(Proj_StateManagement)" />
    <ProjectReference Include="$(Proj_TreeTraceFramework)" />
    <ProjectReference Include="$(Proj_UniversalMiddleware)" />
    <ProjectReference Include="$(Proj_UniversalWorkflowFramework)" />
    <ProjectReference Include="$(Proj_EventBindingOrchestrator)" />
    <ProjectReference Include="$(Proj_TaskStatusPool)" />
    <ProjectReference Include="$(Proj_AiScheduling)" />
    <ProjectReference Include="$(Proj_ControlLookup)" />
    <ProjectReference Include="$(Proj_ScopeFramework)" />
    <!-- ★ HostAssembly 通用宿主装配框架：与 Share 家族其他子项目一致，聚合项目引用并排除其源码，避免类型在 Share.dll 重复编译（CS0433） -->
    <ProjectReference Include="$(Proj_HostAssembly)" />
    <ProjectReference Include="$(Proj_Share_ConfigurationModels)" />
  </ItemGroup>

  <!-- 子项目源码排除由上方 EnableDefaultCompileItems=false 统一承担（不再逐条 <Compile Remove>） -->

</Project>


