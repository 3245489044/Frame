<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用决策框架（Decision Rules）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>通用、规范、可扩展的运行时裁决框架：决策 = 纯函数（单一 JSON → 单一 JSON）。声明式规则模型（when/then：field 统一 JSONPath + 匹配/输出策略）+ 加载/校验/审计 + 热重载 + Merge/Delegate 输出。以 BasicMethod.DecisionEngine 为基础引擎（复用其条件求值/优先级选择/引擎组合），对基础引擎覆盖不了的声明式/匹配/输出/文件化逻辑在框架层扩充。LLM-free，可脱离 Agent 供调度/路由/护栏等任意 JSON 消费者复用。</ModuleRule_Description>
    <ModuleRule_Keywords>决策;规则;引擎;裁决;匹配;输出;校验;审计;热重载;策略</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="基础引擎 = BasicMethod.DecisionEngine：复用其 ConditionEvaluator(条件求值) / RuleBasedDecisionEngine(优先级选择) / CompositeDecisionEngine(引擎组合)，不重写底座" />
    <ModuleRule_Rule Include="基础引擎覆盖不了的逻辑（声明式模型 / 匹配策略 / 输出策略 / 加载校验审计热重载 / 模板渲染）在本层扩充" />
    <ModuleRule_Rule Include="JSON 统一经 Plate.JsonMethod（JsonPathHelper/TemplateFormatter/JsonValidationService）" />
    <ModuleRule_Rule Include="引擎 LLM-free：不引用 LlmMessage/LlmResult 等 LLM 契约，结果经 RuleContext/DecisionRuleResult 消费方适配" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要按输入文本/上下文决定输出或动作（调度/路由/护栏/工具选择/LocalLlm）时，使用本框架" />
    <ModuleRule_Prompt Include="有状态/下一步决策或需多引擎组合时，经 RuleSetDecisionEngine 复用 BasicMethod.DecisionEngine 的 CompositeDecisionEngine" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Strategy.DecisionRules</RootNamespace>
    <AssemblyName>Strategy.DecisionRules</AssemblyName>
    <Description>通用决策框架（Decision Rules）— 以 BasicMethod.DecisionEngine 为底座的可扩展声明式裁决引擎</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 底座：基础决策引擎（零依赖），复用其条件求值 / 优先级选择 / 引擎组合 -->
    <ProjectReference Include="$(BasicMethodRoot)DecisionEngine\DecisionEngine.csproj" />
    <!-- 扩充依赖：平台级统一 JSON 框架（jsonPath 匹配 / 占位符渲染 / 规则文件校验），不污染底座 -->
    <ProjectReference Include="$(PlateDir)JsonMethod\JsonMethod.csproj" />
  </ItemGroup>

</Project>
