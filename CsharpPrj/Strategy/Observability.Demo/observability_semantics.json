{
  "version": "1.0",
  "entities": [ "Run", "Step" ],
  "events": {
    "RunStarted": { "entity": "Run" },
    "RunCompleted": { "entity": "Run", "metrics": { "elapsed_ms": "double" } },
    "StepStarted": { "entity": "Step" },
    "StepCompleted": {
      "entity": "Step",
      "required": [ "workId" ],
      "metrics": { "score": "double", "elapsed_ms": "double" }
    },
    "StepFailed": { "entity": "Step", "metrics": { "elapsed_ms": "double" } }
  }
}
