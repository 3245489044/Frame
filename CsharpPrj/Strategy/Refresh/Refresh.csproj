<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>通用刷新框架（Refresh）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>UI 刷新通用框架（零领域 / 零 HTML / 零 Plate）：把「何时刷 / 是否刷 / 怎么落地 / 是否有进展」收拢为单一实现——L0 契约（RefreshRequest / RefreshArtifact 产物结论 / RefreshOutcome / DeliveryResult 送达与内容变化分离 / InFlightLease 在途租约 / SlotRefreshState 反馈状态 / RefreshTrigger / RefreshContract 常量单源）+ L1 调度引擎（RefreshScheduler：Change/Heartbeat/Fallback 三车道 + 单拍互斥 + 无进展退避 + 停滞熔断 + 失败置回 + 空闲零推送）+ L2 写仲裁（RefreshArbiter：每 slot 单调版本 + baseline 过期即丢 + 在飞 latest-wins + 未变化不推进 baseline）+ 编排面（RefreshRegistry 登记 + RefreshService.ExecuteAsync 唯一入口 + RefreshJson 门面）。领域只实现 IRefreshRenderer / IRefreshSource / IInFlightSource / IRefreshSink 端口接入，节拍 / 合并 / 去重 / 退避 / 熔断 / 仲裁全在框架侧单源。</ModuleRule_Description>
    <ModuleRule_Keywords>刷新;节拍;节流;去重;指纹;单飞;合并;写仲裁;调度;dirty;轮询;通用框架</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="机制与语义分离：本工程不得出现 agent/conversation/db/task/session/history 等具体领域字符串；领域词只经 IRefreshSource/IRefreshRenderer 由上层注入" />
    <ModuleRule_Rule Include="单一实现：节拍/合并/去重/重试/优先级/仲裁只有一份（RefreshScheduler + RefreshArbiter + RefreshService），禁各域再造 XxxTimer/XxxThrottle/XxxDirty 变体" />
    <ModuleRule_Rule Include="契约常量（refresh / 1000 / 30000）只有一处声明（RefreshContract），宿主与页面两端同源" />
    <ModuleRule_Rule Include="框架内零 HTML / 零 Plate 类型（不得 using Plate.* / UiBackend.*）；通道解析由域侧委托注入" />
    <ModuleRule_Rule Include="本工程零 Surface 类型/零 Surface 依赖：窗口帧渲染器等宿主适配一律在 Strategy.SurfaceHosting（同层独立工程）" />
    <ModuleRule_Rule Include="空闲零推送；未送达必置回重试（at-least-once，不静默失刷）；索引/明细不得双份真源" />
    <ModuleRule_Rule Include="在途只认 InFlightLease（Kind=Executable ∧ Active ∧ Deadline 未过）；禁止 bool 在途判定；渲染只认 RefreshArtifact，禁止不透明 object 产物" />
    <ModuleRule_Rule Include="只有 DeliveryResult.Delivered ∧ ContentChanged 才推进 baseline；Unchanged/Skipped 记为 NoChange，不是错误" />
    <ModuleRule_Rule Include="无进展心跳按 1s→2s→4s→8s→16s→30s 退避；达到阈值 / 超截止 / 心跳窗口过期 ⇒ 每槽一次 RefreshStalled + StallPolicy" />
  </ItemGroup>

  <ItemGroup Label="ModuleRule_Prompts">
    <ModuleRule_Prompt Include="当需要「区域按变化刷新 / 节流窗口 / 内容去重 / 失败置回重试 / 写落地仲裁」时，使用本框架（实现 IRefreshRenderer 注册即可接入，不写定时器与去重表）" />
    <ModuleRule_Prompt Include="当某域自建 XxxTimer / XxxThrottle / _lastXxxHtml 缓存时，一律收拢到本框架（RefreshService 为唯一编排面）" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Strategy.Refresh</RootNamespace>
    <AssemblyName>Strategy.Refresh</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Description>UI 刷新通用框架（Refresh）— 「何时刷 / 是否刷 / 怎么落地」单源实现</Description>
  </PropertyGroup>
</Project>
