<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>数据中心适配（宿主设施）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>DataCenter 宿主设施适配层：把引擎/宿主设施（BasicMethod.Block 初始化块、FrameworkAbstractions 服务定位器）适配为 DataCenter 端口实现，使 DataCenter.Core 的构造与实现不再出现引擎设施类型。G2 设施端口化的落点工程（对标 CallCenter.Adapters）。</ModuleRule_Description>
    <ModuleRule_Keywords>DataCenter;适配器;Adapters;Block;服务定位器;宿主设施</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="G2：引擎/宿主设施只在本工程出现（Core 经端口注入）" />
    <ModuleRule_Rule Include="本工程单向引用 Core + Abstractions；Core 不得反向引用" />
    <ModuleRule_Rule Include="CsharpPrj 经权威烘焙二进制引用（对齐 CallCenter.Adapters 约定）" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DataCenter.Adapters</RootNamespace>
    <AssemblyName>DataCenter.Adapters</AssemblyName>
    <Description>DataCenter 宿主设施适配 —— Block 初始化块 / 服务定位器注册（端口实现）</Description>
  </PropertyGroup>

  <!-- ★ 烘焙轨（方案 B，2026-09-12）：CsharpPrj 上游走权威烘焙二进制引用（Private=false 不复制产物）。 -->
  <ItemGroup Label="CsharpPrjBakedRefs">
    <!-- 宿主初始化编排基类（BasicMethod.Block）/ 状态块契约 -->
    <Reference Include="BasicMethod.Block" HintPath="$(CsharpBuildOutputDir)BasicMethod.Block.dll" Private="false" />
    <!-- 宿主服务定位器（FrameworkAbstractions） -->
    <Reference Include="FrameworkAbstractions" HintPath="$(CsharpBuildOutputDir)FrameworkAbstractions.dll" Private="false" />
    <!-- 状态块契约（Share.StateManagement） -->
    <Reference Include="Share.StateManagement" HintPath="$(CsharpBuildOutputDir)Share.StateManagement.dll" Private="false" />
    <!-- 数据面协议（CSG.Unified）：本区共享 GlobalUsings\Usings.External.cs 的编译期依赖（须直接声明，烘焙轨不传递） -->
    <Reference Include="CSG.Unified" HintPath="$(CsharpBuildOutputDir)CSG.Unified.dll" Private="false" />
    <!-- 引擎存储契约（IStorageCell）：兼容构造与适配器签名 -->
    <Reference Include="Modules.TConfig" HintPath="$(CsharpBuildOutputDir)Modules.TConfig.dll" Private="false" />
    <!-- 引擎存储实现（StorageCell）：legacy 后端 scope 分区载体（F-35 方案 A：引擎会话子单元） -->
    <Reference Include="Modules.InternalStorage" HintPath="$(CsharpBuildOutputDir)Modules.InternalStorage.dll" Private="false" />
  </ItemGroup>

  <!-- ★ 仅顺序边（见 DataCenter.Core.csproj 同款说明）：本工程在 MainProj.sln 烘焙闭包内。 -->
  <ItemGroup Label="CsharpPrjBuildOrderOnly">
    <ProjectReference Include="$(CsharpProjectRoot)\Modules\InternalStorage\InternalStorage.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\BasicMethod\Map\Block\Block.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\Share\Foundations\FrameworkAbstractions\FrameworkAbstractions.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\Share\Foundations\StateManagement\StateManagement.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\Plate\TConfig\TConfig.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通用状态能力（StateCenter/StateStore）与端口契约 -->
    <ProjectReference Include="..\DataCenter.Core\DataCenter.Core.csproj" />
    <ProjectReference Include="..\DataCenter.Abstractions\DataCenter.Abstractions.csproj" />
  </ItemGroup>

</Project>
