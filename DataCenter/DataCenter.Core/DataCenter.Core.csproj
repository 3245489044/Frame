<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>数据中心核心</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>跨语言运行时数据中心核心 —— 数据面(CSG CanonicalForm) + 控制面(作用域/分层/事务/订阅/代数/迁移) + 纯契约消费。持有全仓唯一的状态中心实现（StateCenter/StateStore/StateOrchestrator/订阅中枢/事务/Actor），与语言无关：任何语言只要能读写 CSG CanonicalForm 即可接入。契约留在 Share.StateManagement（纯契约），语言栈不进本层。</ModuleRule_Description>
    <ModuleRule_Keywords>数据中心;DataCenter;状态中心;StateCenter;CSG;运行时数据;热更新;分层;事务;订阅;代数</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="本模块是跨语言通用运行时数据框架的核心，依赖 CSG.Unified（协议）、Share.StateManagement（纯契约）与 DataCenter.Abstractions（端口）" />
    <ModuleRule_Rule Include="R-DC1：CSG 主 schema 只扩不改（扩展域 csg://runtime-data），CsgProtocol v1.0.0 语义冻结" />
    <ModuleRule_Rule Include="R-DC2：不引语言栈与应用层工程，保持语言无关" />
    <ModuleRule_Rule Include="G1/G4：不出现领域词汇；领域逻辑经 DataCenter.Extensions.* 单向消费本层端口注入，本层无反向引用" />
    <ModuleRule_Rule Include="G2：宿主设施（Block 初始化块/服务定位器/引擎存储/派发）不进本层——经端口 IDataCell/IStateDispatch/IStateInitializer 注入；Compat 目录仅保留契约强制的迁移期适配" />
    <ModuleRule_Rule Include="契约强制引用（非自主选择）：IStateCenter.Cell→IStorageCell（TConfig）；IStateOrchestrator.ExecutePipelineAsync→ExecutionPipeline（BasicMethod.Block）。G5 契约收口后消除" />
    <ModuleRule_Rule Include="命名空间暂沿用 Operation.StateBlock.*（迁移期零破坏），后续可经类型重构切换为 DataCenter.Core.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DataCenter.Core</RootNamespace>
    <AssemblyName>DataCenter.Core</AssemblyName>
    <Description>数据中心核心 —— 跨语言运行时数据框架（数据面 CSG + 控制面）</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 数据面协议：CSG 统一中间表示（Configuration-StateMachine-Graph） -->
    <ProjectReference Include="$(CsharpProjectRoot)\Protocol\CSG\CSG.Unified\CSG.Unified.csproj" />
    <!-- 纯契约：IStateCenter/IStateStore/StateKey/StateSnapshot/StateBlock/StatePipeline（R1 红线：契约只放 Share.StateManagement） -->
    <ProjectReference Include="$(CsharpProjectRoot)\Share\Foundations\StateManagement\StateManagement.csproj" />
    <!-- 端口层：IDataCell/IDataCellFactory/IStateDispatch/IStateInitializer（零依赖纯端口） -->
    <ProjectReference Include="..\DataCenter.Abstractions\DataCenter.Abstractions.csproj" />
    <!-- 契约枚举 StorageLayer（Plate 层）+ Compat 适配器所需的 IStorageCell 契约面（引擎实现不进本层） -->
    <ProjectReference Include="$(CsharpProjectRoot)\Plate\TConfig\TConfig.csproj" />
    <!-- 契约强制（非自主选择）：Share 契约 IStateOrchestrator 暴露 ExecutionPipeline/PipelineResult（BasicMethod.Block 类型），
         实现 IStateCenter 必须解析这些类型。Core 自身不使用 Block 初始化块设施（已迁 DataCenter.Adapters）；
         G5 契约收口（Share 降纯契约）后可消除。 -->
    <ProjectReference Include="$(CsharpProjectRoot)\BasicMethod\Map\Block\Block.csproj" />
  </ItemGroup>

</Project>
