<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>数据中心核心</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>跨语言运行时数据中心核心 —— 数据面(CSG CanonicalForm) + 控制面(作用域/分层/事务/订阅/代数/迁移) + 纯契约消费。持有全仓唯一的状态中心实现（StateCenter/StateStore/StateOrchestrator/订阅中枢/事务/Actor），与语言无关：任何语言只要能读写 CSG CanonicalForm 即可接入。契约留在 Share.StateManagement（纯契约），语言栈不进本层。</ModuleRule_Description>
    <ModuleRule_Keywords>数据中心;DataCenter;状态中心;StateCenter;CSG;运行时数据;热更新;分层;事务;订阅;代数</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="本模块是跨语言通用运行时数据框架的核心，依赖 CSG.Unified（协议）、Share.StateManagement（纯契约）与 DataCenter.Abstractions（端口）" />
    <ModuleRule_Rule Include="R-DC1：CSG 主 schema 只扩不改（扩展域 csg://runtime-data），CsgProtocol v1.0.0 语义冻结" />
    <ModuleRule_Rule Include="R-DC2：不引语言栈与应用层工程，保持语言无关" />
    <ModuleRule_Rule Include="G1/G4：不出现领域词汇；领域逻辑经 DataCenter.Extensions.* 单向消费本层端口注入，本层无反向引用" />
    <ModuleRule_Rule Include="G2：宿主设施（Block 初始化块/服务定位器/引擎存储/派发）不进本层——经端口 IDataCell/IStateInitializer 注入；Compat 目录仅保留契约强制的迁移期适配" />
    <ModuleRule_Rule Include="契约强制引用（非自主选择）：IStateCenter.Cell→IStorageCell（TConfig）；IStateOrchestrator.ExecutePipelineAsync→ExecutionPipeline（BasicMethod.Block）。G5 契约收口后消除" />
    <ModuleRule_Rule Include="命名空间暂沿用 Operation.StateBlock.*（迁移期零破坏），后续可经类型重构切换为 DataCenter.Core.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DataCenter.Core</RootNamespace>
    <AssemblyName>DataCenter.Core</AssemblyName>
    <Description>数据中心核心 —— 跨语言运行时数据框架（数据面 CSG + 控制面）</Description>
  </PropertyGroup>

  <!-- ★ 烘焙轨（方案 B，2026-09-12）：CsharpPrj 上游一律走权威烘焙二进制引用（$(CsharpBuildOutputDir)），
       Private=false 不复制产物；程序集名/闭包完整性单一真源见 Projects\BuildFramework\CsharpBakeRefs.props。 -->
  <ItemGroup Label="CsharpPrjBakedRefs">
    <!-- 数据面协议：CSG 统一中间表示（Configuration-StateMachine-Graph） -->
    <Reference Include="CSG.Unified" HintPath="$(CsharpBuildOutputDir)CSG.Unified.dll" Private="false" />
    <!-- 纯契约：IStateCenter/IStateStore/StateKey/StateSnapshot/StateBlock/StatePipeline（R1 红线：契约只放 Share.StateManagement） -->
    <Reference Include="Share.StateManagement" HintPath="$(CsharpBuildOutputDir)Share.StateManagement.dll" Private="false" />
    <!-- 契约枚举 StorageLayer（Plate 层）+ Compat 适配器所需的 IStorageCell 契约面（引擎实现不进本层） -->
    <Reference Include="Modules.TConfig" HintPath="$(CsharpBuildOutputDir)Modules.TConfig.dll" Private="false" />
    <!-- 契约强制（非自主选择）：Share 契约 IStateOrchestrator 暴露 ExecutionPipeline/PipelineResult（BasicMethod.Block 类型），
         实现 IStateCenter 必须解析这些类型；G5 契约收口（Share 降纯契约）后可消除。 -->
    <Reference Include="BasicMethod.Block" HintPath="$(CsharpBuildOutputDir)BasicMethod.Block.dll" Private="false" />
  </ItemGroup>

  <!-- ★ 仅顺序边（ReferenceOutputAssembly=false）：二进制引用无 MSBuild 顺序边，而本工程处于 MainProj.sln 烘焙闭包内
       （CsharpPrj\Operation\StateHoldDriven 源码引用本工程）——这些边不消费上游源码类型、不复制其产物，
       只把上游工程排在编译之前，保证干净机器上 `dotnet build MainProj.sln` 与 `DataCenter.slnx` 不出现上游 dll 竞态缺失。 -->
  <ItemGroup Label="CsharpPrjBuildOrderOnly">
    <ProjectReference Include="$(CsharpProjectRoot)\Protocol\CSG\CSG.Unified\CSG.Unified.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\Share\Foundations\StateManagement\StateManagement.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\Plate\TConfig\TConfig.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(CsharpProjectRoot)\BasicMethod\Map\Block\Block.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 端口层：IDataCell/IDataCellFactory/IStateInitializer（零依赖纯端口） -->
    <ProjectReference Include="..\DataCenter.Abstractions\DataCenter.Abstractions.csproj" />
    <!-- 契约层：图契约与框架端口（IStateProjector/IStateRegistry/IStateGeneration/IDataCenterRoot）；Core 提供其实现 -->
    <ProjectReference Include="..\DataCenter.Protocol\DataCenter.Protocol.csproj" />
  </ItemGroup>

</Project>
