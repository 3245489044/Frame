<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>数据中心域扩展（循环决策）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>DataCenter 域扩展示例：循环裁决 × 状态落地。消费 DataCenter.Core 的通用分层键与状态能力，把确定性核心（Budget/Token/Flag/Round/LastEval）与轮决策记录落为可审计、可回放的状态。单向引用 Core（控制反转：Core 不知道本工程存在），裁决语义权威仍在 Share.TaskStatusPool.Loops。</ModuleRule_Description>
    <ModuleRule_Keywords>DataCenter;域扩展;循环决策;状态落地;单向引用</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="G4：本扩展单向引用 DataCenter.Core；Core 无任何对本扩展的反向引用" />
    <ModuleRule_Rule Include="R7：裁决语义唯一权威仍在 Share.TaskStatusPool.Loops，本扩展只做状态落地，不复制裁决" />
    <ModuleRule_Rule Include="R8：确定性核心单一写口（LoopStateStore.Save）" />
    <ModuleRule_Rule Include="命名空间沿用 Operation.StateBlock.Decision（迁移期零破坏，消费方零改动）" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Operation.StateBlock.Decision</RootNamespace>
    <AssemblyName>DataCenter.Extensions.LoopDecision</AssemblyName>
    <Description>DataCenter 域扩展 —— 循环决策状态化（消费 Core 通用状态能力与端口）</Description>
  </PropertyGroup>

  <!-- ★ 烘焙轨（方案 B，2026-09-12）：CsharpPrj 上游走权威烘焙二进制引用（Private=false 不复制产物）。 -->
  <ItemGroup Label="CsharpPrjBakedRefs">
    <!-- 循环决策原语（裁决语义唯一权威，本扩展只消费不复制） -->
    <Reference Include="Share.TaskStatusPool" HintPath="$(CsharpBuildOutputDir)Share.TaskStatusPool.dll" Private="false" />
    <!-- 状态契约（本扩展源码直用 Share.StateManagement） -->
    <Reference Include="Share.StateManagement" HintPath="$(CsharpBuildOutputDir)Share.StateManagement.dll" Private="false" />
    <!-- 本区共享 Usings.External.cs 的编译期依赖（烘焙轨不传递，须直接声明） -->
    <Reference Include="CSG.Unified" HintPath="$(CsharpBuildOutputDir)CSG.Unified.dll" Private="false" />
    <Reference Include="Modules.TConfig" HintPath="$(CsharpBuildOutputDir)Modules.TConfig.dll" Private="false" />
  </ItemGroup>

  <!-- ★ 仅顺序边（见 DataCenter.Core.csproj 同款说明）：保证干净机器上本工程先编出上游再编译。 -->
  <ItemGroup Label="CsharpPrjBuildOrderOnly">
    <ProjectReference Include="$(CsharpProjectRoot)\Share\Orchestration\TaskStatusPool\TaskStatusPool.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 通用状态能力：分层键方案/客户端 + 状态中心门面（Core 通用件） -->
    <ProjectReference Include="..\DataCenter.Core\DataCenter.Core.csproj" />
  </ItemGroup>

</Project>
