<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================
       DataCenter.Standards —— 三本台账（ports/data/events/fakes）的
       模型读取 + 机器校验 + 装载（设计文档 §3.2）。
       分层：只引 DataCenter.Protocol（纯契约）+ 平台 JSON 框架 Plate.JsonMethod
       （烘焙二进制引用：容错读取 / 元素原语 / 原文层重复键扫描 / schema 子集校验的唯一实现）
       + 零依赖结构遍历骨架 BasicMethod.Declarative.StructuralWalk（Plate 层，与 Ledger 同模式的烘焙引用）。
       纪律：语言无关、无领域词汇；校验失败即阻断（不 warn）。
       ============================================================ -->
  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>数据标准（三本台账装载与校验）</ModuleRule_Title>
    <ModuleRule_Layer>3</ModuleRule_Layer>
    <ModuleRule_Description>跨语言数据标准层：把端口/数据/事件/替身四类声明（JSON 台账）装载为中立的 IStandardCatalog，并执行一致性判据（C1 键唯一、C2 ports.emits ⊆ events、C3 events.carries ⊆ data、C4 跨切字段 ⊆ data、C5 data.producer ⊆ ports∪白名单、C6 版本单调、C7–C14 端口 impl 实现面）。职责面：① 词表单源（PortImplVocabulary 为唯一 C# 源，schema enum 为 SchemaEnumSynchronizer 生成物）；② 键闭包（StandardJson.EnsureLayerKeys 唯一实现，层入口逐层调用）；③ 结构门接线（LoadValidated 默认跑 schema 校验，四 schema 经 EmbeddedResource 内嵌）；④ 判据单源（产物字段判据核 = OutFieldContract，内核 FieldContractValidator 转发）。只引 DataCenter.Protocol 与平台 JSON 框架 Plate.JsonMethod；不引引擎/宿主/产品设施。⑤ 遍历单源（impl 声明树下钻唯一实现 = StandardNodeWalk，表达式子槽表 = PortImplVocabulary.ExprSlots，算法骨架 = 烘焙零依赖件 BasicMethod.Declarative.StructuralWalk）。</ModuleRule_Description>
    <ModuleRule_Keywords>DataCenter;标准;端口台账;数据标准;事件标准;校验;C1-C14;词表单源;键闭包;结构门;跨语言</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="L0.5 标准层：台账模型 + 校验 + 装载（纯数据，零机制依赖）——不得引 Strategy.Observability 类型（避免机制↔标准互依赖）" />
    <ModuleRule_Rule Include="校验失败即阻断（StandardViolationException，不 warn）——声明漂移必须当场可见" />
    <ModuleRule_Rule Include="标准只读：本工程不写台账文件（真源 = 产品台账），不缓存跨进程状态" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>DataCenter.Standards</RootNamespace>
    <AssemblyName>DataCenter.Standards</AssemblyName>
    <Description>DataCenter 数据标准层 —— 三本台账的模型读取 / 六条机器判据 / 装载</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataCenter.Protocol\DataCenter.Protocol.csproj" />
  </ItemGroup>

  <!-- 结构门内嵌：schema 物理位置不动（真源仍在 DataCenter\schemas），构建期链接进本程序集，
       使「装载期结构校验」零路径接线（消费方无需知道仓库布局）。 -->
  <ItemGroup Label="EmbeddedSchemas">
    <EmbeddedResource Include="..\schemas\ports.schema.json" Link="Schemas\ports.schema.json" LogicalName="DataCenter.Standards.Schemas.ports.schema.json" />
    <EmbeddedResource Include="..\schemas\events.schema.json" Link="Schemas\events.schema.json" LogicalName="DataCenter.Standards.Schemas.events.schema.json" />
    <EmbeddedResource Include="..\schemas\fakes.schema.json" Link="Schemas\fakes.schema.json" LogicalName="DataCenter.Standards.Schemas.fakes.schema.json" />
    <EmbeddedResource Include="..\schemas\data.schema.json" Link="Schemas\data.schema.json" LogicalName="DataCenter.Standards.Schemas.data.schema.json" />
  </ItemGroup>

  <!-- ★ 烘焙轨（方案 B）：通用声明式契约台账机制 + 平台 JSON 框架均走权威烘焙二进制引用（Private=false 不复制产物）；
       JSON 机制（容错读取 / 元素原语 / 重复键扫描 / schema 子集校验）唯一实现于 Plate.JsonMethod。 -->
  <ItemGroup Label="CsharpPrjBakedRefs">
    <Reference Include="BasicMethod.Declarative.Ledger" HintPath="$(CsharpBuildOutputDir)BasicMethod.Declarative.Ledger.dll" Private="false" />
    <Reference Include="BasicMethod.Declarative.StructuralWalk" HintPath="$(CsharpBuildOutputDir)BasicMethod.Declarative.StructuralWalk.dll" Private="false" />
    <Reference Include="Plate.JsonMethod" HintPath="$(CsharpBuildOutputDir)Plate.JsonMethod.dll" Private="false" />
  </ItemGroup>

  <!-- 仅顺序边：二进制引用无 MSBuild 顺序边，把框架工程排在编译之前（不消费其源码类型、不复制产物）。
       路径经 $(Proj_*) 取（单一真源 = CsharpPrj\modules.json，见 DataCenter\Directory.Build.props 的生成式 Import）。 -->
  <ItemGroup Label="CsharpPrjBuildOrderOnly">
    <ProjectReference Include="$(Proj_DeclarativeLedger)" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(Proj_StructuralWalk)" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="$(Proj_JsonMethod)" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
