<Project>

  <!-- ============================================================
       仓库根属性（单一真源）
       定义各主目录项目根，供全库 csproj 经 $(...) 属性引用（杜绝逐处相对路径）。
       移动/重命名任一主目录（如 Agent → Projects\Agent）只需改此处一处，csproj 零改动。
       子级 Directory.Build.props（Agent/CSharpTest/FileDriven 等）经 GetPathOfFileAbove
       向上 Import 本文件继承这些属性；无自有 props 的目录（如 CentralTest\AgentTest）
       由 MSBuild 就近规则自动加载本文件。
       ============================================================ -->
  <PropertyGroup Label="RepoRoot">
    <!-- 预置默认 Configuration（仅空时设 Debug）：Directory.Build.props 的求值先于 Common.props 的默认注入，
         若此处不预置，下方 CsharpBuildOutputDir 用 $(Configuration) 会在 props 求值期被固化成
         无配置层的扁平 BuildOutput\（dotnet build *.sln / msbuild 直跑 csproj 时必现，产物目录分裂）；
         显式传 -c Release 时条件不成立、不被覆盖。 -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>
    <CsharpProjectRoot>$(RepoRoot)CsharpPrj</CsharpProjectRoot>
    <AgentProjectRoot>$(RepoRoot)Projects\Agent</AgentProjectRoot>
    <EngineProjectRoot>$(RepoRoot)Projects\Engine</EngineProjectRoot>
    <ProduceProjectRoot>$(RepoRoot)Projects\Produce</ProduceProjectRoot>
    <FileDrivenProjectRoot>$(RepoRoot)FileDriven</FileDrivenProjectRoot>
    <!-- ★ CsharpPrj 权威产物目录（单一真源）：供产品项目用 <Reference HintPath="$(CsharpBuildOutputDir)\X.dll" />
         引用 CsharpPrj 的 dll，避免直接从源码重复编译 CsharpPrj。
         ★ 注意：不得含 $(TargetFramework)。CsharpPrj\Directory.Build.props 先于各 csproj 加载，
         求值 OutputPath 时 $(TargetFramework) 尚未定义，产物实际统一落在 BuildOutput\$(Configuration)\
         （无 TFM 层，全仓一致）。此处若加 $(TargetFramework) 会解析到不存在的 net10.0-windows 子目录。 -->
    <CsharpBuildOutputDir>$(CsharpProjectRoot)\BuildOutput\$(Configuration)\</CsharpBuildOutputDir>
  </PropertyGroup>

</Project>
