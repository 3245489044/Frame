@{
    # ===== SpecGeneratedBoundary 门禁基线（单源；守卫 = Operation\DSL\Check-SpecGeneratedBoundary.ps1）=====
    # 语义：spec **生成面 / 手写面**分离的**结构事实**（R4 SEP）——源码树零生成物、生成物必落生成根、
    #   生成物头注释在册、源 ⇄ 产物双向、manifest 一致性（条件判据）、obj 面无第二生成物（K2 二选一）。
    # 与 SpecBoundary（R0 冻结）分工：R0 记「边界两份清单」；本件落「目录契约 + 重生成一致性」。
    # 每条事实必带 Origin/DueWhen（四分事实见 Baselines\README.md）。
    Schema = 'gate-baseline-v1'
    Gate   = 'SpecGeneratedBoundary'

    # 扫描面（源码树；生成根 / `_deprecated` 在遍历中显式排除）。
    SourceScanRoots = @{
        Value = @(
            'Environment\CentralTest\AgentTest'
            'Environment\CentralTest\TestInfrastructure.Tests\Cases'
            'Environment\CentralTest\UsharpTests'
            'Environment\CentralTest\CSharpTest\Modules.Tests'
            'Frame\CsharpPrj\Strategy\Observability'
            'Projects\Plug\Agent\src'
        )
        Origin = 'Derived'
        DueWhen = ''
    }

    # obj 面扫描根（K2「两处生成物」面；限定三处消费方父根，防全仓递归）。
    ObjScanRoots = @{
        Value = @(
            'Environment\CentralTest'
            'Frame\CsharpPrj'
            'Projects\Plug\Agent'
        )
        Origin = 'Derived'
        DueWhen = ''
    }

    # 生成根（产物唯一落点；不入库 / 不进源码树）。
    GeneratedRoots = @{
        Value = @(
            'Environment\CentralTest\BuildOutput\Debug\SpecGen'
        )
        Origin = 'Derived'
        DueWhen = ''
    }

    # 生成物文件名模式（源码树内出现即违规，手写遗留白名单除外）。
    GeneratedPatterns = @{
        Value = @(
            '*SpecTests.g.cs'
            'SpecPorts.g.cs'
            '*.spec.json'
        )
        Origin = 'Derived'
        DueWhen = ''
    }

    # obj 面第二生成物模式（`EmitCompilerGeneratedFiles` 被临时开启时落 `obj\...\generated\SpecSourceGen\`）。
    ObjGeneratedPatterns = @{
        Value = @(
            '*SpecTests.g.cs'
            'SpecPorts.g.cs'
        )
        Origin = 'Derived'
        DueWhen = ''
    }

    # 生成物头注释前缀（生成根内产物首行须以此开头 ⇒ 防手造产物混入生成根）。
    SpecJsonHeaderPrefix = @{
        Value = '// 生成物，勿手改'
        Origin = 'Derived'
        DueWhen = ''
    }

    GeneratedCodeHeaderPrefix = @{
        Value = '// <auto-generated/>'
        Origin = 'Derived'
        DueWhen = ''
    }

    # 手写遗留 .spec.json（tracked、无生成物头注释）：与 SpecBoundary.HandwrittenLegacyJson 同源。
    HandwrittenLegacyJson = @{
        Value = @(
            'Environment\CentralTest\TestInfrastructure.Tests\Cases\adapter-demo\adapter-demo.spec.json'
            'Environment\CentralTest\TestInfrastructure.Tests\Cases\spec-kernel\spec-kernel.spec.json'
        )
        Origin = 'Debt'
        DueWhen = '把这两件迁为 .specs 真源（TestInfrastructure.Tests 接入 SpecSourceGen）后，本键值与 SpecBoundary.HandwrittenLegacyJson 一并删除'
    }

    # 正对照下限（防判据无标的假绿；结构计数，非文件计数）。
    MinScanRoots = @{
        Value = 4
        Origin = 'Derived'
        DueWhen = ''
    }

    MinGeneratedPatterns = @{
        Value = 2
        Origin = 'Derived'
        DueWhen = ''
    }
}
