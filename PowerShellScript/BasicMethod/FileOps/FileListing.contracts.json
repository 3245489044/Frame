      ],
      "output_schema": {
        "status": "success|failure",
        "message": "string",
        "data": { "Path": "string", "Recurse": "bool", "Pattern": "string", "Files": "array", "Dirs": "array", "TotalFiles": "int", "TotalDirs": "int" },
