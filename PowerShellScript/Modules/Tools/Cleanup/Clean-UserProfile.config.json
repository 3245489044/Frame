{
  "description": "Clean-UserProfile.ps1 的配置文件 - 定义要清理的应用缓存路径和规则",

  "excludeDirs": [
    "config", "Config", "CONFIG",
    "users", "Users", "USERS",
    "All Users",
    "templates", "Templates",
    "User Data",
    "startup", "Startup",
    "addons"
  ],

  "cacheKeywords": [
    "cache", "cached", "cacheddata",
    "temp", "tmp", "temporary",
    "log", "logs",
    "crash", "crashpad", "crashdump", "crashdumps",
    "gpucache",
    "webstorage",
    "local storage",
    "partitions",
    "backup", "recover",
    "update", "updater",
    "download", "downloads",
    "npm-cache",
    "code cache", "code_cache",
    "service worker", "service_worker", "serviceworker",
    "session storage", "sessionstorage",
    "blob storage", "blobstorage",
    "file system", "filesystem",
    "indexeddb",
    "webfonts",
    "origin trials", "origintrials",
    "dcsdk",
    "cachedextensionvsixs",
    "http-cache", "packages-cache", "global-packages",
    "cacheddata", "cacheddatav2",
    "remote-cache", "remote-caches",
    "keytar", "local-history"
  ],

  "categories": [
    {
      "name": "AI IDE",
      "label": "AI IDE 缓存",
      "items": [
        {
          "path": "{APPDATA}\\Trae CN",
          "label": "Trae CN",
          "description": "Trae AI IDE 的缓存/日志/临时文件",
          "mode": "scan"
        },
        {
          "path": "{APPDATA}\\Code",
          "label": "VS Code (Code)",
          "description": "VS Code 的缓存/日志/临时文件",
          "mode": "scan"
        },
        {
          "path": "{USERPROFILE}\\.vscode",
          "label": "VS Code (.vscode)",
          "description": "VS Code 的缓存/日志/临时文件",
          "mode": "scan"
        },
        {
          "path": "{APPDATA}\\Cursor",
          "label": "Cursor",
          "description": "Cursor IDE 的缓存/日志/临时文件",
          "mode": "scan"
        },
        {
          "path": "{APPDATA}\\Windsurf",
          "label": "Windsurf",
          "description": "Windsurf IDE 的缓存/日志/临时文件",
          "mode": "scan"
        },
        {
          "path": "{APPDATA}\\Trae",
          "label": "Trae",
          "description": "Trae IDE 的缓存/日志/临时文件",
          "mode": "scan"
        }
      ]
    },
    {
      "name": "腾讯系",
      "label": "腾讯系应用缓存",
