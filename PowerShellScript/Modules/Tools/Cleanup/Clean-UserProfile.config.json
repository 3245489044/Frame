    {
      "name": "Windows 临时文件",
      "label": "Windows 临时文件",
      "items": [
        {
          "path": "{LOCALAPPDATA}\\Temp",
          "label": "Temp",
          "description": "应用程序临时文件，可安全清理",
          "mode": "temp"
        }
      ]
    },
    {
      "name": "包管理器",
      "label": "包管理器缓存",
      "items": [
        {
          "path": "{USERPROFILE}\\.nuget",
          "label": "NuGet 包缓存",
          "description": ".NET NuGet 包缓存，可运行 'dotnet nuget locals all --clear' 替代",
          "mode": "scan"
        },
        {
          "path": "{APPDATA}\\npm-cache",
          "label": "npm 缓存",
          "description": "npm 包缓存，可运行 'npm cache clean --force' 替代",
          "mode": "direct"
        },
        {
          "path": "{LOCALAPPDATA}\\pip",
          "label": "pip 缓存",
          "description": "Python pip 包缓存",
          "mode": "scan"
        }
      ]
    }
