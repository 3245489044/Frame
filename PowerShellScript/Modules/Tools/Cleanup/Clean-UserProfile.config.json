        {
          "path": "{APPDATA}\\Tencent\\WeChat",
          "label": "WeChat (微信)",
          "description": "微信的缓存文件（保留配置）",
          "mode": "scan",
          "exclude": ["All Users"]
        },
        {
          "path": "{APPDATA}\\Tencent\\xwechat",
          "label": "xwechat (企业微信)",
          "description": "企业微信的缓存文件（保留配置）",
          "mode": "scan",
          "exclude": ["All Users"]
        },
        {
          "path": "{APPDATA}\\Tencent\\WeGame",
          "label": "WeGame (游戏平台)",
          "description": "WeGame 的缓存文件（保留配置）",
          "mode": "scan",
          "exclude": ["data"]
        },
        {
          "path": "{APPDATA}\\Tencent\\QQMusic",
          "label": "QQMusic (QQ音乐)",
          "description": "QQ音乐的缓存文件（保留配置）",
          "mode": "scan",
          "exclude": ["UserData"]
        }
      ]
