<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- ★ 已移除 UseWindowsForms 依赖，FrameworkErrors 不再使用 MessageBox -->
    <RootNamespace>Common.Diagnostics</RootNamespace>
    <AssemblyName>Share.Diagnostics</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BasicMethod\BasicMethod.csproj" />
    <ProjectReference Include="..\..\BasicMethod\Logging\BasicMethod.Logging.csproj" />
    <ProjectReference Include="..\UniversalReference\UniversalWorkflowFramework.csproj" />
  </ItemGroup>

  <!-- ★ 确保 log-categories.json 复制到输出目录，供 LogCategoryLoader 在运行时加载 -->
  <ItemGroup>
    <None Update="log-categories.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
