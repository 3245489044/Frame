<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="$(MicrosoftCodeAnalysisCSharpVersion)" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="$(MicrosoftCodeAnalysisCommonVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Agent\Agent.csproj">
      <Aliases>AgentAlias</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\BasicMethod\RoslynMethod\RoslynMethod.csproj" />
  </ItemGroup>

  <!-- ★ 引用 BasicMethod（获取 SkeletonFlow 等基础类型） -->
  <ItemGroup>
    <ProjectReference Include="..\..\BasicMethod\BasicMethod.csproj" />
  </ItemGroup>

  <!-- ★ 引用 WorkFlowMethod -->
  <ItemGroup>
    <ProjectReference Include="..\..\Operation\WorkFlowMethod\WorkFlowMethod.csproj" />
  </ItemGroup>

  <!-- 排除测试目录 -->
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <None Include="Tests\**\*.cs" />
  </ItemGroup>

</Project>
