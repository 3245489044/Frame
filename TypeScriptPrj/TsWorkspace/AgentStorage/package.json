{
  "name": "agent-storage",
  "version": "0.1.0",
  "type": "module",
  "description": "AgentStorage — 通用 Agent 存储契约：声明式 FS 路由 + 模块层 DB 接管 + 统一策略/观测（Cline/Claude/未来 Agent 共用）。",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "keywords": [
    "agent",
    "storage",
    "session",
    "sqlite",
    "intercept"
  ],
  "license": "MIT",
  "dependencies": {
    "fs-sink": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
