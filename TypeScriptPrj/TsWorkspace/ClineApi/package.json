{
  "name": "cline-api",
  "version": "1.0.0",
  "type": "module",
  "description": "Cline 桥接 API — 在 C#/PowerShell 中通过 JSON CLI 调用 Cline 编码代理（headless 模式）",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "cline-api": "build/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/cli.js",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "cline",
    "api",
    "bridge",
    "csharp"
  ],
  "license": "MIT",
  "dependencies": {
    "@cline/sdk": "0.0.95",
    "agent-storage": "workspace:*",
    "csg-protocol": "workspace:*",
    "fs-sink": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
