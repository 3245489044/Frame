{
  "name": "set_module_rule",
  "description": "注入或更新 .csproj 文件的 ModuleRule 属性",
  "handler": "set-rule",
  "template": "write",
  "inputSchema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "description": ".csproj 文件路径（相对于项目根目录）"
      },
      "title": {
        "type": "string",
        "description": "模块显示名称"
      },
      "layer": {
        "type": "number",
        "description": "层编号（0-7）"
      },
      "description": {
        "type": "string",
        "description": "模块功能描述"
      },
      "keywords": {
        "type": "string",
        "description": "关键词列表（分号分隔，如：数据;分析;工具）"
      },
      "rules": {
        "type": "string",
        "description": "模块级规则列表（分号分隔）"
      },
      "prompts": {
        "type": "string",
        "description": "模块级提示词列表（分号分隔）"
      },
      "slnPath": {
        "type": "string",
        "description": ".sln 文件路径（如 CsharpPrj/MainProj.sln），提供后以 .sln 为基准坐标"
      },
      "projectRoot": {
        "type": "string",
        "description": "项目根目录路径（默认：WorkFlowPrj，与 slnPath 互斥）"
      }
    },
    "required": ["path", "title", "layer", "description"]
  },
  "implementation": {
    "imports": [
      { "name": "setModuleRule", "from": "../core/parser" },
      { "name": "resolveProjectRootWithSln", "from": "../core/utils" }
    ],
    "requiredParams": ["path", "title", "layer", "description"],
    "optionalParams": [
      { "name": "keywords", "type": "string" },
      { "name": "rules", "type": "string" },
      { "name": "prompts", "type": "string" }
    ],
    "mainCall": "setModuleRule(path, { title, layer, description, keywords, rules, prompts }, projectRoot, slnPath)"
  }
}
