{
  "compilerOptions": {
    "outDir": "./build",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "references": [
    { "path": "BasicMethod" },
    { "path": "CsprojContext" },
    { "path": "MCPBridge" },
    { "path": "MCPFramework" },
    { "path": "ClineApi" },
    { "path": "Protocol/CSG" }
  ],
  "files": []
}
