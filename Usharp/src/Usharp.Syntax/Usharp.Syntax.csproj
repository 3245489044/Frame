<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="ModuleRule">
    <ModuleRule_Title>Usharp 语法层</ModuleRule_Title>
    <ModuleRule_Description>Usharp 语言表层：复用 Plate.DslMethod 的 DslParser/DslIndex，把 [Space]/[Matrix]/[Flow]/[Ref] 四前缀解析为语法模型（SpaceDecl/MatrixDecl/FlowDecl/RefDecl）。</ModuleRule_Description>
    <ModuleRule_Keywords>Usharp;DSL;语法;空间;矩阵;流;引用</ModuleRule_Keywords>
  </PropertyGroup>

  <ItemGroup Label="ModuleRule_Rules">
    <ModuleRule_Rule Include="本层只做语法（文本→语法模型），不做校验（校验归 Usharp.Semantics）" />
    <ModuleRule_Rule Include="解析一律复用 Plate.DslMethod.Parsing.DslParser，禁止另写行解析器（抽象再生）" />
    <ModuleRule_Rule Include="[Obs] 观测声明只做语法投影（UsharpObsDecl），不引任何观测类型（核心零观测依赖）" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Usharp.Syntax</RootNamespace>
    <AssemblyName>Usharp.Syntax</AssemblyName>
    <Description>Usharp 语言语法层 — 四前缀语法模型 + DslParser 复用</Description>
    <!-- CA2255：本包用 [ModuleInitializer] 在程序集加载时把 Usharp 前缀作用域登记进 DslPrefixRegistry，
         属刻意为之的「包自持注册」模式（保证 Registry 在任何解析前即可发现本包），故显式抑制。 -->
    <NoWarn>$(NoWarn);CA2255</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(UsharpCsharpPrjRoot)Plate\DslMethod\DslMethod.csproj" />
  </ItemGroup>

</Project>
