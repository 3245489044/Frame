<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Usharp.Emit.Tests</RootNamespace>
    <AssemblyName>Usharp.Emit.Tests</AssemblyName>
  </PropertyGroup>

  <!-- 测试包版本单一真源 = CsharpPrj versions.json 生成物（避免本工程另写一份版本字面量） -->
  <Import Project="$(UsharpCsharpPrjRoot)generated\Directory.Build.props.versions.generated.props"
          Condition="Exists('$(UsharpCsharpPrjRoot)generated\Directory.Build.props.versions.generated.props')" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)" />
    <PackageReference Include="MSTest.TestAdapter" Version="$(MSTestTestAdapterVersion)" />
    <PackageReference Include="MSTest.TestFramework" Version="$(MSTestTestFrameworkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Usharp.Emit\Usharp.Emit.csproj" />
  </ItemGroup>

  <!-- 等价比对真源：样例（samples\*.ushar）与既有工作流配置（agent-loop.json）直接拷入输出，
       禁止在测试里复制一份声明文本（否则等价判据退化为自我比对）。 -->
  <ItemGroup>
    <None Include="..\..\samples\*.ushar" CopyToOutputDirectory="PreserveNewest"
          Link="samples\%(Filename)%(Extension)" />
    <None Include="..\..\..\..\Projects\Plug\Agent\Config\workflows\agent-loop.json"
          CopyToOutputDirectory="PreserveNewest" Link="workflows\agent-loop.json"
          Condition="Exists('..\..\..\..\Projects\Plug\Agent\Config\workflows\agent-loop.json')" />
  </ItemGroup>

</Project>
